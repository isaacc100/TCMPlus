<Project>
  <PropertyGroup>
    <TCMVersion>0.4.3-DEV</TCMVersion>
    <Version>$(TCMVersion)</Version>
    <AssemblyVersion>0.4.3.0</AssemblyVersion>
    <FileVersion>0.4.3.0</FileVersion>
    <InformationalVersion>$(TCMVersion)</InformationalVersion>
  </PropertyGroup>

  <Target Name="ValidateTcmVersion" BeforeTargets="BeforeBuild">
    <Error Condition="$([System.Text.RegularExpressions.Regex]::IsMatch('$(TCMVersion)', '^\d+\.\d+\.\d+(-DEV)?$')) != 'True'"
           Text="TCMVersion must use X.Y.Z for production or X.Y.Z-DEV for development." />
  </Target>
</Project>
