<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:TCMPlus.App.ViewModels" x:Class="TCMPlus.App.Controls.StationMirrorCard" x:DataType="vm:StationViewModel" IsHitTestVisible="False">
 <UserControl.Styles><Style Selector="Border.station"><Setter Property="Background" Value="#E7F5EC"/><Setter Property="BorderBrush" Value="#2F8F61"/><Setter Property="BorderThickness" Value="2"/><Setter Property="CornerRadius" Value="8"/></Style><Style Selector="Border.station.occupied"><Setter Property="Background" Value="#FCEAEA"/><Setter Property="BorderBrush" Value="#B94B4B"/></Style><Style Selector="Border.header"><Setter Property="Background" Value="#2F8F61"/></Style><Style Selector="Border.header.occupied"><Setter Property="Background" Value="#B94B4B"/></Style></UserControl.Styles>
 <Border Classes="station" Classes.occupied="{Binding IsOccupied}" ClipToBounds="True"><Grid RowDefinitions="Auto,*"><Border Height="28" IsVisible="{Binding HasType}" Classes="header" Classes.occupied="{Binding IsOccupied}"><TextBlock Text="{Binding Type}" Foreground="White" FontSize="10" FontWeight="Bold" Margin="10,0" VerticalAlignment="Center"/></Border><StackPanel Grid.Row="1" Margin="11,9" Spacing="4"><TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="#364958" TextTrimming="CharacterEllipsis"/><Border IsVisible="{Binding IsOccupied}" Background="#364958" CornerRadius="9" HorizontalAlignment="Left" Padding="7,3"><TextBlock Text="{Binding PatientCounterText}" Foreground="White" FontSize="10" FontWeight="Bold"/></Border><TextBlock Text="{Binding StatusText}" Foreground="#364958" FontSize="11"/><TextBlock Text="{Binding PatientArrivalText}" IsVisible="{Binding IsOccupied}" Foreground="#50636B" FontSize="10"/></StackPanel></Grid></Border>
</UserControl>
