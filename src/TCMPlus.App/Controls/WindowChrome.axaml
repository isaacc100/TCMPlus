<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:TCMPlus.App.Controls"
             x:Class="TCMPlus.App.Controls.WindowChrome"
             Height="42"
             PointerPressed="OnPointerPressed">
  <Border Background="{StaticResource InkBrush}"
          BorderBrush="{StaticResource FrameBrush}"
          BorderThickness="0,0,0,1"
          Padding="14,0">
    <Grid ColumnDefinitions="Auto,*,Auto">
      <TextBlock Text="TCM+" Foreground="White" FontWeight="Bold" VerticalAlignment="Center"/>
      <TextBlock Name="WindowTitle"
                 Grid.Column="1"
                 Foreground="#E8F2ED"
                 FontWeight="SemiBold"
                 Margin="12,0"
                 TextTrimming="CharacterEllipsis"
                 VerticalAlignment="Center"/>
      <controls:WindowControlButtons Name="Controls" Grid.Column="2"/>
    </Grid>
  </Border>
</UserControl>
