<views:ResponsiveDialogWindow xmlns="https://github.com/avaloniaui"
                              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                              xmlns:views="using:TCMPlus.App.Views"
                              x:Class="TCMPlus.App.Views.RecentSessionsWindow"
                              x:CompileBindings="False"
                              Width="650"
                              Height="510"
                              WindowStartupLocation="CenterOwner"
                              Title="Recent shifts"
                              Background="#F5F8F4">
  <Border Classes="dialog-card">
    <Grid RowDefinitions="Auto,*,Auto">
      <TextBlock Classes="dialog-header" Text="Recent shifts"/>
      <ScrollViewer Grid.Row="1" Classes="dialog-body" Margin="0,12,0,0">
        <StackPanel Spacing="10">
          <ListBox Name="SessionsList"
                   Height="260"
                   DisplayMemberBinding="{Binding ShiftName}"
                   SelectionChanged="OnSelectionChanged"/>
          <TextBlock Name="SessionDetails" Foreground="#60737A" TextWrapping="Wrap"/>
          <TextBox Name="PasswordInput" PasswordChar="*" PlaceholderText="Session password"/>
          <TextBlock Name="ValidationMessage" Foreground="#963D3D" TextWrapping="Wrap"/>
        </StackPanel>
      </ScrollViewer>
      <WrapPanel Grid.Row="2" Classes="dialog-footer">
        <Button Content="Rename" Click="OnRename"/>
        <Button Content="Delete" Click="OnDelete"/>
        <Button Content="Export .tcm" Click="OnExport"/>
        <Button Content="Cancel" Click="OnCancel"/>
        <Button Classes="primary" Content="Load shift" Click="OnLoad"/>
      </WrapPanel>
    </Grid>
  </Border>
</views:ResponsiveDialogWindow>
