<views:ResponsiveDialogWindow xmlns="https://github.com/avaloniaui"
                              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                              xmlns:views="using:TCMPlus.App.Views"
                              x:Class="TCMPlus.App.Views.RecentSessionsWindow"
                              x:CompileBindings="False"
                              Width="650"
                              Height="510"
                              WindowStartupLocation="CenterOwner"
                              Title="Recent shifts"
                              Background="#F5F8F4">
  <Border Classes="dialog-card">
    <Grid RowDefinitions="*,Auto">
      <views:RecentSessionsView Name="SessionsView"/>
      <Button Grid.Row="1" Content="Cancel" HorizontalAlignment="Right" Margin="0,12,0,0" Click="OnCancel"/>
    </Grid>
  </Border>
</views:ResponsiveDialogWindow>
