<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="TCMPlus.App.Views.ProcessConflictWindow" Width="470" Height="260" CanResize="False" WindowStartupLocation="CenterScreen" Title="TCM+ already running" Background="#F5F8F4">
 <Border Margin="20" Padding="24" Background="White" BorderBrush="#D39B28" BorderThickness="1" CornerRadius="12"><StackPanel Spacing="14"><TextBlock Text="Another TCM+ instance is running" FontSize="20" FontWeight="Bold" Foreground="#364958"/><TextBlock Name="MessageText" TextWrapping="Wrap" Foreground="#60737A"/><TextBlock Name="ErrorText" Foreground="#B94B4B" TextWrapping="Wrap"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8"><Button Content="Exit this instance" Click="OnExit"/><Button Background="#3B6064" Foreground="White" Content="Terminate others and continue" Click="OnTerminate"/></StackPanel></StackPanel></Border>
</Window>
