<views:ResponsiveDialogWindow xmlns="https://github.com/avaloniaui"
                              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                              xmlns:views="using:TCMPlus.App.Views"
                              x:Class="TCMPlus.App.Views.ShiftSetupWindow"
                              Width="540"
                              Height="690"
                              CanResize="False"
                              WindowStartupLocation="CenterScreen"
                              Title="Start shift"
                              Background="#F5F8F4">
  <Border Classes="dialog-card" CornerRadius="14">
    <Grid RowDefinitions="Auto,*,Auto">
      <StackPanel Spacing="5">
        <TextBlock Classes="dialog-header" Text="Start a shift" FontSize="24" HorizontalAlignment="Center"/>
        <TextBlock Text="Create a shift name and PIN before opening the treatment centre."
                   Foreground="#60737A"
                   TextWrapping="Wrap"
                   TextAlignment="Center"/>
      </StackPanel>
      <ScrollViewer Grid.Row="1" Classes="dialog-body" Margin="0,14,0,0">
        <StackPanel Spacing="12">
          <StackPanel Spacing="4" HorizontalAlignment="Center">
            <Button Classes="secondary" Content="Check for updates" Click="OnCheckForUpdates" HorizontalAlignment="Center"/>
            <TextBlock Name="UpdateStatus"
                       Text="Updates are checked when TCM+ starts."
                       Foreground="#60737A"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       MaxWidth="430"/>
          </StackPanel>
          <TextBlock Text="Shift name" FontWeight="SemiBold" Foreground="#364958"/>
          <TextBox Name="ShiftNameInput" PlaceholderText="e.g. Night shift"/>
          <TextBlock Text="Six-digit shift PIN" FontWeight="SemiBold" Foreground="#364958"/>
          <TextBox Name="ShiftPinInput" MaxLength="6" PasswordChar="*" Width="300" HorizontalAlignment="Center" Height="48" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" FontSize="20" PlaceholderText="Six-digit PIN" AutomationProperties.Name="Six-digit shift PIN" KeyDown="OnPinKeyDown"/>
          <CheckBox Content="Show PIN" HorizontalAlignment="Center" Click="OnTogglePinVisibility"/>
          <TextBlock Text="Session password" FontWeight="SemiBold" Foreground="#364958"/>
          <TextBox Name="SessionPasswordInput" PasswordChar="*" PlaceholderText="At least 8 characters"/>
          <TextBox Name="ConfirmSessionPasswordInput" PasswordChar="*" PlaceholderText="Confirm session password"/>
          <TextBlock Text="The map starts at Compact size. Increase it later while editing the Treatment Centre layout." Classes="muted" TextWrapping="Wrap"/>
          <TextBlock Name="ValidationMessage"
                     Foreground="#963D3D"
                     HorizontalAlignment="Center"
                     TextWrapping="Wrap"
                     TextAlignment="Center"/>
        </StackPanel>
      </ScrollViewer>
      <WrapPanel Grid.Row="2" Classes="dialog-footer">
        <Button Content="Connect terminal" Click="OnConnectTerminal"/>
        <Button Classes="secondary" Content="Load existing shift" Click="OnLoadExistingShift"/>
        <Button Classes="primary" Content="Start shift" Click="OnStartShift"/>
      </WrapPanel>
    </Grid>
  </Border>
</views:ResponsiveDialogWindow>
