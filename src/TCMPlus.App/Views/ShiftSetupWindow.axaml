<views:ResponsiveDialogWindow xmlns="https://github.com/avaloniaui"
                              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                              xmlns:views="using:TCMPlus.App.Views"
                              x:Class="TCMPlus.App.Views.ShiftSetupWindow"
                              Width="790"
                              Height="500"
                              CanResize="False"
                              WindowStartupLocation="CenterScreen"
                              Title="Create shift"
                              Background="#F5F8F4">
  <Border Background="White">
    <Grid ColumnDefinitions="220,*">
      <Border Background="#12363B" Padding="20">
        <Grid RowDefinitions="Auto,Auto,*,Auto">
          <StackPanel Spacing="4">
            <TextBlock Text="TCM+" Foreground="White" FontSize="25" FontWeight="Bold"/>
            <TextBlock Text="Choose how to begin" Foreground="#C9E4CA"/>
          </StackPanel>

          <StackPanel Grid.Row="1" Margin="0,24,0,0" Spacing="10">
            <Button Classes="launch-nav active" Content="Start new shift" HorizontalContentAlignment="Left"/>
            <Button Classes="launch-nav" Content="Open saved shift" HorizontalContentAlignment="Left" Click="OnLoadExistingShift"/>
            <Button Classes="launch-nav" Content="Connect as terminal" HorizontalContentAlignment="Left" Click="OnConnectTerminal"/>
          </StackPanel>

          <StackPanel Grid.Row="3" Spacing="6">
            <Button Classes="update-link" Content="Check for updates" HorizontalAlignment="Left" Click="OnCheckForUpdates"/>
            <TextBlock Name="UpdateStatus"
                       Text="Checking for updates..."
                       Foreground="#C9E4CA"
                       FontSize="11"
                       TextWrapping="Wrap"/>
            <TextBlock Name="VersionLabel" Foreground="#87BBA2" FontSize="11" Margin="0,5,0,0"/>
          </StackPanel>
        </Grid>
      </Border>

      <Grid Grid.Column="1" Margin="28,22,28,24" RowDefinitions="Auto,*,Auto">
        <StackPanel Spacing="3">
          <TextBlock Classes="dialog-header" Text="Create a shift" FontSize="26"/>
          <TextBlock Text="Set the shift identity and security before opening the treatment centre."
                     Foreground="#60737A" TextWrapping="Wrap"/>
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,20,0,0" ColumnDefinitions="*,18,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto">
          <TextBlock Text="Shift name *" FontWeight="SemiBold" Foreground="#364958"/>
          <TextBox Name="ShiftNameInput" Grid.Row="1" PlaceholderText="e.g. Night shift"/>
          <TextBlock Name="ShiftNameError" Grid.Row="2" Foreground="#963D3D" FontSize="11" TextWrapping="Wrap" MinHeight="18"/>

          <TextBlock Grid.Column="2" Text="Shift PIN *" FontWeight="SemiBold" Foreground="#364958"/>
          <Grid Grid.Row="1" Grid.Column="2" ColumnDefinitions="*,Auto" ColumnSpacing="6">
            <TextBox Name="ShiftPinInput" MaxLength="6" PasswordChar="*"
                     HorizontalContentAlignment="Center" FontSize="18"
                     PlaceholderText="6 digits" AutomationProperties.Name="Six-digit shift PIN"
                     KeyDown="OnPinKeyDown"/>
            <Button Grid.Column="1" Classes="secondary compact-action" Content="Show" Click="OnTogglePinVisibility"/>
          </Grid>
          <TextBlock Name="ShiftPinError" Grid.Row="2" Grid.Column="2" Foreground="#963D3D" FontSize="11" TextWrapping="Wrap" MinHeight="18"/>

          <TextBlock Grid.Row="3" Text="Session password *" FontWeight="SemiBold" Foreground="#364958" Margin="0,8,0,0"/>
          <TextBox Name="SessionPasswordInput" Grid.Row="4" PasswordChar="*" PlaceholderText="At least 8 characters"/>
          <TextBlock Name="PasswordError" Grid.Row="5" Foreground="#963D3D" FontSize="11" TextWrapping="Wrap" MinHeight="18"/>

          <TextBlock Grid.Row="3" Grid.Column="2" Text="Confirm password *" FontWeight="SemiBold" Foreground="#364958" Margin="0,8,0,0"/>
          <TextBox Name="ConfirmSessionPasswordInput" Grid.Row="4" Grid.Column="2" PasswordChar="*" PlaceholderText="Repeat password"/>
          <TextBlock Name="ConfirmPasswordError" Grid.Row="5" Grid.Column="2" Foreground="#963D3D" FontSize="11" TextWrapping="Wrap" MinHeight="18"/>
        </Grid>

        <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="12">
          <TextBlock Name="ValidationMessage" Foreground="#963D3D" VerticalAlignment="Center" TextWrapping="Wrap"/>
          <Button Grid.Column="1" Classes="primary" Content="Create shift" Click="OnStartShift" MinWidth="126"/>
        </Grid>
      </Grid>
    </Grid>
  </Border>

  <views:ResponsiveDialogWindow.Styles>
    <Style Selector="Button.launch-nav">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="13,10"/>
      <Setter Property="CornerRadius" Value="7"/>
    </Style>
    <Style Selector="Button.launch-nav:pointerover">
      <Setter Property="Background" Value="#FFFFFF18"/>
      <Setter Property="Foreground" Value="White"/>
    </Style>
    <Style Selector="Button.launch-nav.active">
      <Setter Property="Background" Value="White"/>
      <Setter Property="Foreground" Value="#12363B"/>
    </Style>
    <Style Selector="Button.update-link">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="0,6"/>
      <Setter Property="MinHeight" Value="32"/>
    </Style>
    <Style Selector="Button.update-link:pointerover">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="White"/>
    </Style>
    <Style Selector="Button.compact-action">
      <Setter Property="MinHeight" Value="44"/>
      <Setter Property="Padding" Value="10,6"/>
    </Style>
  </views:ResponsiveDialogWindow.Styles>
</views:ResponsiveDialogWindow>
