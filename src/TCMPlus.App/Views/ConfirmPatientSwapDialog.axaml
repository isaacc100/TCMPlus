<views:ResponsiveDialogWindow xmlns="https://github.com/avaloniaui"
                              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                              xmlns:views="using:TCMPlus.App.Views"
                              x:Class="TCMPlus.App.Views.ConfirmPatientSwapDialog"
                              Width="440"
                              Height="245"
                              CanResize="False"
                              WindowStartupLocation="CenterOwner"
                              Title="Confirm patient swap"
                              Background="#F5F8F4">
  <Border Classes="dialog-card">
    <Grid RowDefinitions="Auto,*,Auto">
      <TextBlock Classes="dialog-header" Text="Swap patients?"/>
      <ScrollViewer Grid.Row="1" Classes="dialog-body" Margin="0,12,0,0">
        <StackPanel Spacing="12">
          <TextBlock Name="DescriptionText" Foreground="#60737A" TextWrapping="Wrap"/>
          <TextBlock Text="This will exchange the patients between both stations." Foreground="#60737A" FontSize="11" TextWrapping="Wrap"/>
        </StackPanel>
      </ScrollViewer>
      <StackPanel Grid.Row="2" Classes="dialog-footer">
        <Button Classes="secondary" Content="Cancel" Click="OnCancel"/>
        <Button Classes="primary" Content="Swap patients" Click="OnConfirm"/>
      </StackPanel>
    </Grid>
  </Border>
</views:ResponsiveDialogWindow>
