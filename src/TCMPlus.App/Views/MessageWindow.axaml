<views:ResponsiveDialogWindow xmlns="https://github.com/avaloniaui"
                              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                              xmlns:views="using:TCMPlus.App.Views"
                              x:Class="TCMPlus.App.Views.MessageWindow"
                              Width="440"
                              Height="230"
                              CanResize="False"
                              WindowStartupLocation="CenterOwner"
                              Background="#F5F8F4">
  <Border Classes="dialog-card">
    <Grid RowDefinitions="Auto,*,Auto">
      <TextBlock Name="Heading" Classes="dialog-header"/>
      <Border Grid.Row="1" Margin="0,12,0,0">
        <TextBlock Name="Message" TextWrapping="Wrap" Foreground="#60737A"/>
      </Border>
      <StackPanel Grid.Row="2" Classes="dialog-footer">
        <Button Name="CancelButton" Content="Cancel" Click="OnCancel"/>
        <Button Name="ConfirmButton" Classes="primary" Content="OK" Click="OnConfirm"/>
      </StackPanel>
    </Grid>
  </Border>
</views:ResponsiveDialogWindow>
