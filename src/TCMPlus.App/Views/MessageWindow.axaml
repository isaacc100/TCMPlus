<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="TCMPlus.App.Views.MessageWindow" Width="440" Height="230" CanResize="False" WindowStartupLocation="CenterOwner" Background="#F5F8F4"><Border Margin="20" Padding="22" Background="White" BorderBrush="#87BBA2" BorderThickness="1" CornerRadius="12"><StackPanel Spacing="14"><TextBlock Name="Heading" FontSize="20" FontWeight="Bold" Foreground="#364958"/><TextBlock Name="Message" TextWrapping="Wrap" Foreground="#60737A"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8"><Button Name="CancelButton" Content="Cancel" Click="OnCancel"/><Button Name="ConfirmButton" Content="OK" Background="#3B6064" Foreground="White" Click="OnConfirm"/></StackPanel></StackPanel></Border></Window>
