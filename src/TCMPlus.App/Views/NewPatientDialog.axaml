<views:ResponsiveDialogWindow xmlns="https://github.com/avaloniaui"
                              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                              xmlns:views="using:TCMPlus.App.Views"
                              x:Class="TCMPlus.App.Views.NewPatientDialog"
                              Width="440"
                              Height="270"
                              CanResize="False"
                              WindowStartupLocation="CenterOwner"
                              Title="New patient"
                              Background="#F5F8F4">
  <Border Classes="dialog-card">
    <Grid RowDefinitions="Auto,*,Auto">
      <TextBlock Classes="dialog-header" Text="New patient"/>
      <Border Grid.Row="1" Margin="0,12,0,0">
        <StackPanel Spacing="11">
          <TextBlock Name="StationText" Foreground="#60737A" TextWrapping="Wrap"/>
          <TextBlock Text="Presenting complaint" FontWeight="SemiBold" Foreground="#364958"/>
          <TextBox Name="ComplaintInput" PlaceholderText="Optional" KeyDown="OnComplaintKeyDown"/>
          <TextBlock Text="No details are required to add the patient." Foreground="#60737A" FontSize="11" TextWrapping="Wrap"/>
        </StackPanel>
      </Border>
      <StackPanel Grid.Row="2" Classes="dialog-footer">
        <Button Classes="secondary" Content="Cancel" Click="OnCancel"/>
        <Button Classes="primary" Content="Add patient" Click="OnAddPatient"/>
      </StackPanel>
    </Grid>
  </Border>
</views:ResponsiveDialogWindow>
