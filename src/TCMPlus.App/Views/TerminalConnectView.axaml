<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="TCMPlus.App.Views.TerminalConnectView">
  <Grid RowDefinitions="Auto,*,Auto">
    <StackPanel Spacing="4">
      <TextBlock Classes="dialog-header" Text="Connect as a terminal" FontSize="26"/>
      <TextBlock Text="Choose the authoritative host. The host operator will approve this terminal using a six-digit verification code."
                 Foreground="#60737A" TextWrapping="Wrap"/>
    </StackPanel>
    <ScrollViewer Grid.Row="1" Margin="0,14,4,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Spacing="10" Margin="0,0,10,0">
        <TextBlock Text="Nearby TCM+ hosts" FontWeight="SemiBold" Foreground="#364958"/>
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
          <Border Classes="select-shell">
            <ComboBox Name="HostList" Classes="shell-select" PlaceholderText="Searching for hosts…"/>
          </Border>
          <Button Name="RefreshButton" Grid.Column="1" Content="Refresh" Click="OnRefresh"/>
        </Grid>
        <TextBlock Name="DiscoveryMessage" Foreground="#60737A" TextWrapping="Wrap"/>
        <Border Background="#F5F8F4" BorderBrush="#D6E5DC" BorderThickness="1" CornerRadius="8" Padding="12">
          <StackPanel Spacing="7">
            <TextBlock Text="Can't find the host?" FontWeight="SemiBold" Foreground="#364958"/>
            <TextBlock Text="Enter the four-character host code, IP address, computer name, or optional host:port."
                       Foreground="#60737A" TextWrapping="Wrap"/>
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
              <TextBox Name="ManualHostInput" PlaceholderText="e.g. A7K9 or 192.168.1.20"/>
              <Button Name="FindButton" Grid.Column="1" Content="Find host" Click="OnFindHost"/>
            </Grid>
          </StackPanel>
        </Border>
        <TextBlock Text="Terminal name" FontWeight="SemiBold" Foreground="#364958"/>
        <TextBox Name="TerminalNameInput" PlaceholderText="e.g. Reception 1"/>
        <Border Name="PairingCodePanel" IsVisible="False" Background="#EAF5EF" BorderBrush="#87BBA2"
                BorderThickness="1" CornerRadius="8" Padding="12">
          <StackPanel Spacing="4" HorizontalAlignment="Center">
            <TextBlock Text="Tell the host operator this code" Foreground="#364958" FontWeight="SemiBold"/>
            <TextBlock Name="PairingCodeText" FontFamily="Consolas" FontSize="34" FontWeight="Bold"
                       Foreground="#3B6064" HorizontalAlignment="Center"/>
            <TextBlock Text="The host operator must type it into the approval window."
                       Foreground="#60737A" TextWrapping="Wrap" TextAlignment="Center"/>
          </StackPanel>
        </Border>
        <TextBlock Name="ValidationMessage" Foreground="#963D3D" TextWrapping="Wrap"/>
      </StackPanel>
    </ScrollViewer>
    <Button Grid.Row="2" Name="ConnectButton" Classes="primary" Content="Request access"
            HorizontalAlignment="Right" Margin="0,12,0,0" Click="OnConnect"/>
  </Grid>
</UserControl>
