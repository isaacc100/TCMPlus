<views:ResponsiveDialogWindow xmlns="https://github.com/avaloniaui"
                              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                              xmlns:views="using:TCMPlus.App.Views"
                              x:Class="TCMPlus.App.Views.MobileTeamEditorDialog"
                              Width="440"
                              Height="310"
                              CanResize="False"
                              WindowStartupLocation="CenterOwner"
                              Title="Mobile team"
                              Background="#F5F8F4">
  <Border Classes="dialog-card">
    <Grid RowDefinitions="Auto,*,Auto">
      <TextBlock Name="Heading" Classes="dialog-header" Text="Add mobile team"/>
      <Border Grid.Row="1" Margin="0,12,0,0">
        <StackPanel Spacing="11">
          <TextBlock Text="Callsign" FontWeight="SemiBold" Foreground="#364958"/>
          <TextBox Name="CallsignInput" PlaceholderText="e.g. RESPONSE 3" KeyDown="OnCallsignKeyDown"/>
          <TextBlock Text="Note" FontWeight="SemiBold" Foreground="#364958"/>
          <TextBox Name="NoteInput" PlaceholderText="Optional, e.g. team member names" KeyDown="OnNoteKeyDown"/>
          <TextBlock Name="ValidationMessage" Foreground="#B94B4B" FontSize="11" TextWrapping="Wrap"/>
        </StackPanel>
      </Border>
      <StackPanel Grid.Row="2" Classes="dialog-footer">
        <Button Classes="secondary" Content="Cancel" Click="OnCancel"/>
        <Button Classes="primary" Content="Save team" Click="OnSave"/>
      </StackPanel>
    </Grid>
  </Border>
</views:ResponsiveDialogWindow>
