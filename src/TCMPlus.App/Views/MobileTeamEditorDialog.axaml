<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="TCMPlus.App.Views.MobileTeamEditorDialog"
        Width="440" Height="310" CanResize="False" WindowStartupLocation="CenterOwner"
        Title="Mobile team" Background="#F5F8F4">
  <Border Margin="18" Background="White" BorderBrush="#D5E2DA" BorderThickness="1" CornerRadius="10" Padding="20">
    <StackPanel Spacing="12">
      <TextBlock Name="Heading" Text="Add mobile team" FontSize="19" FontWeight="Bold" Foreground="#364958"/>
      <TextBlock Text="Callsign" FontWeight="SemiBold" Foreground="#364958"/>
      <TextBox Name="CallsignInput" PlaceholderText="e.g. RESPONSE 3" KeyDown="OnCallsignKeyDown"/>
      <TextBlock Text="Note" FontWeight="SemiBold" Foreground="#364958"/>
      <TextBox Name="NoteInput" PlaceholderText="Optional, e.g. team member names" KeyDown="OnNoteKeyDown"/>
      <TextBlock Name="ValidationMessage" Foreground="#B94B4B" FontSize="11"/>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
        <Button Classes="secondary" Content="Cancel" Click="OnCancel"/>
        <Button Classes="primary" Content="Save team" Click="OnSave"/>
      </StackPanel>
    </StackPanel>
  </Border>
</Window>
