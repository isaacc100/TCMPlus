<views:ResponsiveDialogWindow xmlns="https://github.com/avaloniaui"
                              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                              xmlns:views="using:TCMPlus.App.Views"
                              x:Class="TCMPlus.App.Views.StandDownMobileTeamDialog"
                              x:CompileBindings="False"
                              Width="510"
                              Height="330"
                              CanResize="False"
                              WindowStartupLocation="CenterOwner"
                              Title="Stand down mobile team"
                              Background="#F5F8F4">
  <Border Classes="dialog-card">
    <Grid RowDefinitions="Auto,*,Auto">
      <TextBlock Name="Heading" Classes="dialog-header"/>
      <ScrollViewer Grid.Row="1" Classes="dialog-body" Margin="0,12,0,0">
        <StackPanel Spacing="11">
          <TextBlock Text="This team still has a patient. Resolve the patient before standing down." Foreground="#60737A" TextWrapping="Wrap"/>
          <TextBlock Text="Transfer to an available station" FontWeight="SemiBold" Foreground="#364958"/>
          <ComboBox Name="StationInput" DisplayMemberBinding="{Binding Name}" PlaceholderText="Choose a station"/>
          <TextBlock Name="NoStationsMessage" Text="No stations are currently available." Foreground="#B94B4B" FontSize="11" TextWrapping="Wrap"/>
        </StackPanel>
      </ScrollViewer>
      <WrapPanel Grid.Row="2" Classes="dialog-footer">
        <Button Classes="secondary" Content="Cancel" Click="OnCancel"/>
        <Button Classes="danger" Content="Discharge patient" Click="OnDischarge"/>
        <Button Name="TransferButton" Classes="primary" Content="Transfer and stand down" Click="OnTransfer"/>
      </WrapPanel>
    </Grid>
  </Border>
</views:ResponsiveDialogWindow>
