<views:ResponsiveDialogWindow xmlns="https://github.com/avaloniaui"
                              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                              xmlns:views="using:TCMPlus.App.Views"
                              x:Class="TCMPlus.App.Views.TerminalConnectWindow"
                              Width="650"
                              Height="690"
                              CanResize="False"
                              WindowStartupLocation="CenterOwner"
                              Title="Connect terminal"
                              Background="#F5F8F4">
  <Border Classes="dialog-card">
    <Grid RowDefinitions="*,Auto">
      <views:TerminalConnectView Name="ConnectView"/>
      <Button Grid.Row="1" Content="Cancel" HorizontalAlignment="Left" Margin="0,12,0,0" Click="OnCancel"/>
    </Grid>
  </Border>
</views:ResponsiveDialogWindow>
