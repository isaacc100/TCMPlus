<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="TCMPlus.App.Views.MobileTeamDeploymentDialog"
        Width="470" Height="285" CanResize="False" WindowStartupLocation="CenterOwner"
        Title="Mobile-team deployment" Background="#F5F8F4">
  <Border Margin="18" Background="White" BorderBrush="#D5E2DA" BorderThickness="1" CornerRadius="10" Padding="22">
    <StackPanel Spacing="13">
      <TextBlock Name="Heading" FontSize="20" FontWeight="Bold" Foreground="#364958"/>
      <TextBlock Text="Location (optional)" FontWeight="SemiBold" Foreground="#364958"/>
      <TextBox Name="LocationInput" PlaceholderText="e.g. West entrance" KeyDown="OnLocationKeyDown"/>
      <TextBlock Text="You can leave this blank and add or change it later." Foreground="#60737A" FontSize="11" TextWrapping="Wrap"/>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,6,0,0">
        <Button Classes="secondary" Content="Cancel" Click="OnCancel"/>
        <Button Name="ConfirmButton" Classes="primary" Content="Deploy" Click="OnConfirm"/>
      </StackPanel>
    </StackPanel>
  </Border>
</Window>
