<views:ResponsiveDialogWindow xmlns="https://github.com/avaloniaui"
                              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                              xmlns:views="using:TCMPlus.App.Views"
                              x:Class="TCMPlus.App.Views.DischargePatientDialog"
                              Width="440"
                              Height="330"
                              CanResize="False"
                              WindowStartupLocation="CenterOwner"
                              Title="Discharge patient"
                              KeyDown="OnKeyDown"
                              Background="#F5F8F4">
  <Border Classes="dialog-card">
    <Grid RowDefinitions="Auto,*,Auto">
      <TextBlock Classes="dialog-header" Text="Discharge patient"/>
      <Border Grid.Row="1" Margin="0,12,0,0">
        <StackPanel Spacing="12">
          <TextBlock Name="StationText" Foreground="#60737A" TextWrapping="Wrap"/>
          <TextBlock Text="Discharge route" FontWeight="SemiBold"/>
          <Border Classes="select-shell">
            <Grid>
              <ComboBox Name="RouteInput" Classes="shell-select"/>
              <PathIcon Classes="dropdown-chevron" Data="M 4,7 L 10,13 L 16,7 Z"/>
            </Grid>
          </Border>
          <TextBlock Text="Outcome (optional)" FontWeight="SemiBold"/>
          <Border Classes="select-shell">
            <Grid>
              <ComboBox Name="OutcomeInput" Classes="shell-select"/>
              <PathIcon Classes="dropdown-chevron" Data="M 4,7 L 10,13 L 16,7 Z"/>
            </Grid>
          </Border>
        </StackPanel>
      </Border>
      <StackPanel Grid.Row="2" Classes="dialog-footer">
        <Button Content="Cancel" Click="OnCancel"/>
        <Button Classes="primary" Content="Discharge" Click="OnDischarge"/>
      </StackPanel>
    </Grid>
  </Border>
</views:ResponsiveDialogWindow>
