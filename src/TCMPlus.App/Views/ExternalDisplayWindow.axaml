<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:TCMPlus.App.ViewModels" xmlns:controls="using:TCMPlus.App.Controls"
        x:Class="TCMPlus.App.Views.ExternalDisplayWindow"
        x:DataType="vm:MainViewModel"
        Title="TCM+ external display"
        WindowDecorations="None"
        ExtendClientAreaToDecorationsHint="False"
        Background="#F5F8F4">
  <Grid RowDefinitions="Auto,*">
    <Border Background="#364958" Padding="28,14">
      <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12"><TextBlock Name="Heading" Foreground="White" FontSize="24" FontWeight="Bold"/><TextBlock Grid.Column="1" Text="{Binding CurrentTimeText}" Foreground="White" FontSize="20" VerticalAlignment="Center"/><controls:WindowControlButtons Grid.Column="2"/></Grid>
    </Border>
    <Grid Grid.Row="1" Name="DashboardPanel" Margin="28" RowDefinitions="Auto,*">
      <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="14">
        <Border Background="White" Padding="18" CornerRadius="10"><StackPanel><TextBlock Text="{Binding AvailableStations}" FontSize="38" FontWeight="Bold" Foreground="#2F8F61"/><TextBlock Text="Available stations"/></StackPanel></Border>
        <Border Grid.Column="1" Background="White" Padding="18" CornerRadius="10"><StackPanel><TextBlock Text="{Binding OccupiedStations}" FontSize="38" FontWeight="Bold" Foreground="#B94B4B"/><TextBlock Text="Occupied stations"/></StackPanel></Border>
        <Border Grid.Column="2" Background="White" Padding="18" CornerRadius="10"><StackPanel><TextBlock Text="{Binding PatientsSeenThisShift}" FontSize="38" FontWeight="Bold" Foreground="#3B6064"/><TextBlock Text="Patients seen this shift"/></StackPanel></Border>
        <Border Grid.Column="3" Background="White" Padding="18" CornerRadius="10"><StackPanel><TextBlock Text="{Binding AverageDischargeText}" FontSize="26" FontWeight="Bold" Foreground="#55828B"/><TextBlock Text="Average discharge time"/></StackPanel></Border>
      </Grid>
      <Grid Grid.Row="1" Margin="0,14,0,0" ColumnDefinitions="1.35*,*" ColumnSpacing="14">
        <Border Background="White" CornerRadius="10" Padding="24">
          <StackPanel Spacing="10"><TextBlock Text="Treatment centre occupancy" FontSize="22" FontWeight="Bold" Foreground="#364958"/><TextBlock Text="Occupied stations over time, scaled to the treatment centre capacity." Foreground="#60737A"/><controls:DashboardTrendChart Points="{Binding OccupancyPoints}" MaximumValue="{Binding TotalStations}" Height="400" LineBrush="#B94B4B"/></StackPanel>
        </Border>
        <Border Grid.Column="1" Background="White" CornerRadius="10" Padding="24">
          <StackPanel Spacing="10"><TextBlock Text="Patients received" FontSize="22" FontWeight="Bold" Foreground="#364958"/><TextBlock Text="Cumulative arrivals, updated in 15-minute intervals." Foreground="#60737A"/><controls:DashboardTrendChart Points="{Binding CumulativeArrivalPoints}" Height="400" LineBrush="#3B6064"/></StackPanel>
        </Border>
      </Grid>
    </Grid>
    <Viewbox Grid.Row="1" Name="MapPanel" IsVisible="False" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"><Grid Width="1200" Height="720"><ItemsControl ItemsSource="{Binding Stations}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas Width="1200" Height="720"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemContainerTheme><ControlTheme x:DataType="vm:StationViewModel" TargetType="ContentPresenter"><Setter Property="Canvas.Left" Value="{Binding CanvasX}"/><Setter Property="Canvas.Top" Value="{Binding CanvasY}"/></ControlTheme></ItemsControl.ItemContainerTheme><ItemsControl.ItemTemplate><DataTemplate><controls:StationMirrorCard Width="{Binding CanvasWidth}" Height="{Binding CanvasHeight}"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></Grid></Viewbox>
  </Grid>
</Window>
