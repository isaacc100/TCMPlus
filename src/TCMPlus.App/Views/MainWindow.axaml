<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:TCMPlus.App.ViewModels"
        xmlns:controls="using:TCMPlus.App.Controls"
        xmlns:charts="using:TCMPlus.App.Controls"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="820"
        x:Class="TCMPlus.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        x:CompileBindings="False"
        Icon="/Assets/avalonia-logo.ico"
        Title="TCM+"
        Width="1280"
        Height="820"
        MinWidth="1040"
        MinHeight="680"
        KeyDown="OnKeyDown"
        Background="{StaticResource CanvasBrush}">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <Window.Styles>
        <Style Selector="Button">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.primary-nav">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="#C9E4CA" />
            <Setter Property="Padding" Value="16,10" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>
        <Style Selector="Button.primary-nav.active">
            <Setter Property="Background" Value="#55828B" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="Button.icon">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="17" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.sub-nav">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="#3B6064" />
            <Setter Property="Padding" Value="13,8" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>
        <Style Selector="Button.sub-nav.active">
            <Setter Property="Background" Value="#E7F5EC" />
            <Setter Property="Foreground" Value="#245A42" />
        </Style>
        <Style Selector="Button.primary">
            <Setter Property="Background" Value="#3B6064" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="14,9" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>
        <Style Selector="Button.secondary">
            <Setter Property="Background" Value="#E7F5EC" />
            <Setter Property="Foreground" Value="#245A42" />
            <Setter Property="BorderBrush" Value="#87BBA2" />
            <Setter Property="Padding" Value="13,8" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>
        <Style Selector="Button.danger">
            <Setter Property="Background" Value="#FCEAEA" />
            <Setter Property="Foreground" Value="#963D3D" />
            <Setter Property="BorderBrush" Value="#E5A0A0" />
            <Setter Property="Padding" Value="13,8" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>
        <Style Selector="Border.card">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#D5E2DA" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
        </Style>
        <Style Selector="TextBlock.muted">
            <Setter Property="Foreground" Value="#60737A" />
        </Style>
        <Style Selector="TextBlock.section-title">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="#364958" />
        </Style>
        <Style Selector="Border.banner">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="BoxShadow" Value="0 6 20 0 #00000033" />
        </Style>
        <Style Selector="Ellipse.notification-info"><Setter Property="Fill" Value="#55828B" /></Style>
        <Style Selector="Ellipse.notification-warning"><Setter Property="Fill" Value="#D39B28" /></Style>
        <Style Selector="Ellipse.notification-error"><Setter Property="Fill" Value="#B94B4B" /></Style>
    </Window.Styles>

    <Grid>
        <Border>
            <Border.Effect><BlurEffect Radius="{Binding ActiveBlurRadius}" /></Border.Effect>
            <Grid RowDefinitions="Auto,Auto,*">
        <Border Background="{StaticResource InkBrush}" Height="62" Padding="28,0">
            <Grid ColumnDefinitions="Auto,*">
                <TextBlock Text="TCM+" Foreground="White" FontSize="23" FontWeight="Bold" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="12">
                    <TextBlock Text="{Binding CurrentTimeText}" Foreground="White" FontFamily="Consolas" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <Button Classes="primary-nav" Classes.active="{Binding IsDashboard}" Content="Dashboard" Command="{Binding ShowDashboardCommand}" />
                    <Button Classes="primary-nav" Classes.active="{Binding IsManager}" Content="Manager" Command="{Binding ShowManagerCommand}" />
                    <Button Classes="icon" Click="OnFullScreenClicked" ToolTip.Tip="Toggle fullscreen">
                        <TextBlock Text="&#xE740;" FontFamily="Segoe Fluent Icons" Foreground="White" FontSize="17" />
                    </Button>
                    <Button Classes="icon" Command="{Binding LockCommand}" ToolTip.Tip="Lock application">
                        <TextBlock Text="&#xE72E;" FontFamily="Segoe Fluent Icons" Foreground="White" FontSize="17" />
                    </Button>
                    <Button Classes="icon" Command="{Binding ShowSettingsCommand}" ToolTip.Tip="Application settings">
                        <TextBlock Text="&#xE713;" FontFamily="Segoe Fluent Icons" Foreground="White" FontSize="17" />
                    </Button>
                    <Button Classes="icon" Click="OnSafeExitClicked" ToolTip.Tip="Seal this shift and exit TCM+">
                        <TextBlock Text="&#xE7E8;" FontFamily="Segoe Fluent Icons" Foreground="White" FontSize="17" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" IsVisible="{Binding IsManager}" Background="White" BorderBrush="#D5E2DA" BorderThickness="0,0,0,1" Padding="28,8">
            <Grid ColumnDefinitions="*,Auto"><StackPanel Orientation="Horizontal" Spacing="4">
                    <Button Classes="sub-nav" Classes.active="{Binding IsMapPage}" Content="Map" Command="{Binding ShowMapCommand}" />
                    <Button Classes="sub-nav" Classes.active="{Binding IsTablesPage}" Content="Tables" Command="{Binding ShowTablesCommand}" />
                    <Button Classes="sub-nav" Classes.active="{Binding IsPatientsPage}" Content="Patients" Command="{Binding ShowPatientsCommand}" />
                    <Button Classes="sub-nav" Classes.active="{Binding IsSetupPage}" Content="Setup" Command="{Binding ShowSetupCommand}" />
                </StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"><TextBlock Text="Quick entry" Classes="muted" VerticalAlignment="Center" /><ToggleSwitch IsChecked="{Binding QuickEntry, Mode=TwoWay}" /></StackPanel></Grid>
        </Border>

        <Grid Grid.Row="2" Margin="28" IsVisible="{Binding IsMapPage}" ColumnDefinitions="220,16,*">
            <Border Classes="card" Padding="18">
                <StackPanel Spacing="18">
                    <TextBlock Text="Treatment centre" Classes="section-title" />
                    <StackPanel Spacing="8">
                        <TextBlock Text="{Binding AvailableStations}" FontSize="34" FontWeight="Bold" Foreground="{StaticResource OpenBrush}" />
                        <TextBlock Text="Available stations" Classes="muted" />
                    </StackPanel>
                    <StackPanel Spacing="8">
                        <TextBlock Text="{Binding OccupiedStations}" FontSize="34" FontWeight="Bold" Foreground="{StaticResource ClosedBrush}" />
                        <TextBlock Text="Occupied stations" Classes="muted" />
                    </StackPanel>
                    <StackPanel Spacing="8">
                        <TextBlock Text="{Binding PatientsSeenThisShift}" FontSize="34" FontWeight="Bold" Foreground="{StaticResource DeepSeaBrush}" />
                        <TextBlock Text="Patients seen this shift" Classes="muted" TextWrapping="Wrap" />
                    </StackPanel>
                    <Button Classes="secondary" Content="{Binding EditModeText}" Command="{Binding ToggleEditModeCommand}" Margin="0,10,0,0" />
                    <Button Classes="primary" Content="Add station" Command="{Binding RequestAddStationCommand}" IsVisible="{Binding IsEditMode}" />
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Classes="card" Padding="0" ClipToBounds="True">
                <Grid RowDefinitions="Auto,*">
                    <Border Background="#EEF5EF" Padding="18,14" BorderBrush="#D5E2DA" BorderThickness="0,0,0,1">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel>
                                <TextBlock Text="Station map" Classes="section-title" />
                                <TextBlock Text="{Binding MapStatusText}" Classes="muted" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Ellipse Width="9" Height="9" Fill="{StaticResource OpenBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="Available" Classes="muted" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Ellipse Width="9" Height="9" Fill="{StaticResource ClosedBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="Occupied" Classes="muted" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Viewbox Grid.Row="1" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Grid Width="1200" Height="720">
                            <controls:DotGridControl Spacing="{Binding GridPixelSize}" />
                            <ItemsControl ItemsSource="{Binding Stations}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Canvas Width="1200" Height="720" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemContainerTheme>
                                    <ControlTheme x:DataType="vm:StationViewModel" TargetType="ContentPresenter">
                                        <Setter Property="Canvas.Left" Value="{Binding CanvasX}" />
                                        <Setter Property="Canvas.Top" Value="{Binding CanvasY}" />
                                    </ControlTheme>
                                </ItemsControl.ItemContainerTheme>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <controls:StationCard Width="{Binding CanvasWidth}" Height="{Binding CanvasHeight}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Border IsVisible="{Binding HasNoStations}" Width="320" Height="150" HorizontalAlignment="Center" VerticalAlignment="Center" Background="#FFFFFFDD" BorderBrush="#87BBA2" BorderThickness="1" CornerRadius="10" Padding="20">
                                <StackPanel Spacing="8" HorizontalAlignment="Center">
                                    <TextBlock Text="No stations configured" FontWeight="Bold" FontSize="17" Foreground="{StaticResource InkBrush}" HorizontalAlignment="Center" />
                                    <TextBlock Text="Edit the treatment centre to add and place the first station." Classes="muted" TextWrapping="Wrap" TextAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Viewbox>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="2" Margin="28" IsVisible="{Binding IsTablesPage}" RowDefinitions="Auto,16,*">
            <Border Classes="card" Padding="20">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Station tables" Classes="section-title" />
                        <TextBlock Text="Each row reflects the current station state." Classes="muted" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Button Classes="secondary" Content="{Binding EditModeText}" Command="{Binding ToggleEditModeCommand}" />
                        <Button Classes="primary" Content="Add station" Command="{Binding RequestAddStationCommand}" IsVisible="{Binding IsEditMode}" />
                    </StackPanel>
                </Grid>
            </Border>
            <Border Grid.Row="2" Classes="card" Padding="0" ClipToBounds="True">
                <ScrollViewer HorizontalScrollBarVisibility="Auto">
                    <StackPanel MinWidth="760">
                        <Border Background="#EEF5EF" Padding="18,13">
                            <Grid ColumnDefinitions="1.4*,1.15*,130,1.25*,Auto">
                                <TextBlock Text="Station" FontWeight="Bold" Foreground="{StaticResource InkBrush}" />
                                <TextBlock Grid.Column="1" Text="Type" FontWeight="Bold" Foreground="{StaticResource InkBrush}" />
                                <TextBlock Grid.Column="2" Text="State" FontWeight="Bold" Foreground="{StaticResource InkBrush}" />
                                <TextBlock Grid.Column="3" Text="Added" FontWeight="Bold" Foreground="{StaticResource InkBrush}" />
                            </Grid>
                        </Border>
                        <ItemsControl ItemsSource="{Binding Stations}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="White" Padding="18,13">
                                        <Grid ColumnDefinitions="1.4*,1.15*,130,1.25*,Auto" ColumnSpacing="8">
                                            <Grid.Styles>
                                                <Style Selector="TextBlock.status">
                                                    <Setter Property="Foreground" Value="#2F8F61" />
                                                    <Setter Property="FontWeight" Value="Bold" />
                                                </Style>
                                                <Style Selector="TextBlock.status.occupied">
                                                    <Setter Property="Foreground" Value="#B94B4B" />
                                                </Style>
                                            </Grid.Styles>
                                            <TextBlock Text="{Binding Name}" IsVisible="{Binding IsOperationalMode}" VerticalAlignment="Center" Foreground="{StaticResource InkBrush}" FontWeight="SemiBold" />
                                            <TextBox Text="{Binding Name}" IsVisible="{Binding IsEditMode}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="{Binding Type}" IsVisible="{Binding IsOperationalMode}" VerticalAlignment="Center" Classes="muted" />
                                            <TextBox Grid.Column="1" Text="{Binding Type}" IsVisible="{Binding IsEditMode}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2" Text="{Binding StatusText}" Classes="status" Classes.occupied="{Binding IsOccupied}" VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="3" Spacing="2" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding PatientCounterText}" FontWeight="SemiBold" Foreground="{StaticResource DeepSeaBrush}" />
                                                <TextBlock Text="{Binding PatientArrivalText}" Classes="muted" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="8">
                                                <Button Classes="secondary" Content="Add Patient" Command="{Binding AddPatientCommand}" IsVisible="{Binding CanAddPatient}" />
                                                <Button Classes="danger" Content="Discharge" Command="{Binding DischargePatientCommand}" IsVisible="{Binding CanDischargePatient}" />
                                                <Button Classes="secondary" Content="Save" Command="{Binding SaveStationCommand}" IsVisible="{Binding IsEditMode}" />
                                                <Button Classes="danger" Content="Delete" Command="{Binding DeleteStationCommand}" IsVisible="{Binding IsEditMode}" IsEnabled="{Binding CanDelete}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <Grid Grid.Row="2" Margin="28" IsVisible="{Binding IsPatientsPage}" RowDefinitions="Auto,16,*">
            <Border Classes="card" Padding="20">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Patients" Classes="section-title" />
                        <TextBlock Text="All patients recorded during this shift. Patient details can be corrected without changing operational history." Classes="muted" />
                    </StackPanel>
                    <Button Grid.Column="1" Classes="secondary" Content="{Binding PatientEditModeText}" Command="{Binding TogglePatientEditModeCommand}" VerticalAlignment="Center" />
                </Grid>
            </Border>
            <Border Grid.Row="2" Classes="card" Padding="0" ClipToBounds="True">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                    <StackPanel MinWidth="1240">
                        <Border Background="#EEF5EF" Padding="18,13">
                            <Grid ColumnDefinitions="90,110,140,160,160,1.35*,1.2*,Auto" ColumnSpacing="8">
                                <TextBlock Text="Patient" FontWeight="Bold" Foreground="{StaticResource InkBrush}" />
                                <TextBlock Grid.Column="1" Text="Status" FontWeight="Bold" Foreground="{StaticResource InkBrush}" />
                                <TextBlock Grid.Column="2" Text="Current station" FontWeight="Bold" Foreground="{StaticResource InkBrush}" />
                                <TextBlock Grid.Column="3" Text="Arrived" FontWeight="Bold" Foreground="{StaticResource InkBrush}" />
                                <TextBlock Grid.Column="4" Text="Discharged" FontWeight="Bold" Foreground="{StaticResource InkBrush}" />
                                <TextBlock Grid.Column="5" Text="Presenting complaint" FontWeight="Bold" Foreground="{StaticResource InkBrush}" />
                                <TextBlock Grid.Column="6" Text="Discharge route" FontWeight="Bold" Foreground="{StaticResource InkBrush}" />
                            </Grid>
                        </Border>
                        <ItemsControl ItemsSource="{Binding Patients}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="White" Padding="18,13">
                                        <Grid ColumnDefinitions="90,110,140,160,160,1.35*,1.2*,Auto" ColumnSpacing="8">
                                            <Grid.Styles>
                                                <Style Selector="TextBlock.status"><Setter Property="Foreground" Value="#2F8F61" /><Setter Property="FontWeight" Value="Bold" /></Style>
                                                <Style Selector="TextBlock.status.discharged"><Setter Property="Foreground" Value="#60737A" /></Style>
                                            </Grid.Styles>
                                            <TextBlock Text="{Binding PatientNumber, StringFormat=Patient {0}}" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{StaticResource DeepSeaBrush}" />
                                            <TextBlock Grid.Column="1" Text="{Binding StatusText}" Classes="status" Classes.discharged="{Binding IsDischarged}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2" Text="{Binding StationText}" Classes="muted" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="3" Text="{Binding AddedAtText}" Classes="muted" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="4" Text="{Binding DischargedAtText}" Classes="muted" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="5" Text="{Binding PresentingComplaintDisplay}" IsVisible="{Binding IsOperationalMode}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                            <TextBox Grid.Column="5" Text="{Binding PresentingComplaint, Mode=TwoWay}" IsVisible="{Binding IsEditMode}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="6" Text="{Binding DischargeRouteDisplay}" IsVisible="{Binding ShowReadOnlyDischargeRoute}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                            <ComboBox Grid.Column="6" ItemsSource="{Binding DischargeRoutes}" SelectedItem="{Binding DischargeRoute, Mode=TwoWay}" IsVisible="{Binding CanEditDischargeRoute}" VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="7" Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsEditMode}">
                                                <Button Classes="secondary" Content="Save" Command="{Binding SaveCommand}" />
                                                <Button Classes="secondary" Content="Cancel" Command="{Binding CancelCommand}" />
                                                <Button Classes="danger" Content="Delete" Command="{Binding DeleteCommand}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="No patients have been recorded for this shift." Classes="muted" IsVisible="{Binding HasNoPatients}" Margin="18,22" HorizontalAlignment="Center" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <Grid Grid.Row="2" Margin="28" IsVisible="{Binding IsSetupPage}">
            <Border Classes="card" Padding="20" Width="520" HorizontalAlignment="Left" VerticalAlignment="Top">
                <StackPanel Spacing="16">
                    <TextBlock Text="Shift setup" Classes="section-title" />
                    <TextBlock Text="Shift details" FontWeight="Bold" Foreground="{StaticResource InkBrush}" />
                    <TextBlock Text="Used to identify this shift and name its save folder." Classes="muted" TextWrapping="Wrap" />
                    <TextBox Text="{Binding ShiftName}" PlaceholderText="Shift name" />
                    <Grid ColumnDefinitions="*,Auto"><TextBlock Text="Shift PIN set" Foreground="#2F8F61" VerticalAlignment="Center"/><Button Grid.Column="1" Classes="secondary" Content="Change PIN" Command="{Binding BeginPinChangeCommand}"/></Grid>
                    <TextBox Text="{Binding NewPin}" PasswordChar="*" MaxLength="6" PlaceholderText="New six-digit PIN" IsVisible="{Binding IsChangingPin}" />
                    <Separator Margin="0,4" />
                    <TextBlock Text="Treatment-centre map" FontWeight="Bold" Foreground="{StaticResource InkBrush}" />
                    <TextBlock Text="Map size" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" />
                    <Border Background="#FFF7D9" BorderBrush="#D39B28" BorderThickness="1" CornerRadius="6" Padding="10"><TextBlock Text="The map can be enlarged later, but cannot be reduced after stations have been placed." Foreground="#765617" TextWrapping="Wrap"/></Border>
                    <StackPanel Orientation="Horizontal" Spacing="8"><Button Classes="secondary" Content="Compact 50 × 30" Command="{Binding SetCompactDensityCommand}" /><Button Classes="secondary" Content="Standard 60 × 36" Command="{Binding SetStandardDensityCommand}" /><Button Classes="secondary" Content="Dense 75 × 45" Command="{Binding SetDenseDensityCommand}" /></StackPanel>
                    <Button Classes="primary" Content="Save changes" Command="{Binding SaveShiftPinCommand}" />
                    <TextBlock Text="{Binding PinStatusText}" Classes="muted" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="2" Margin="28" IsVisible="{Binding IsSettings}" ColumnDefinitions="210,18,*">
            <Border Classes="card" Padding="12"><StackPanel Spacing="5"><TextBlock Text="Settings" Classes="section-title" Margin="8,4,0,10"/><Button Classes="sub-nav" Content="General" Command="{Binding ShowSettingsGeneralCommand}"/><Button Classes="sub-nav" Content="Operations" Command="{Binding ShowSettingsOperationsCommand}"/><Button Classes="sub-nav" Content="Displays" Command="{Binding ShowSettingsDisplaysCommand}"/></StackPanel></Border>
            <Border Grid.Column="2" Classes="card" Padding="24"><Grid><StackPanel IsVisible="{Binding IsSettingsGeneral}" Spacing="12"><TextBlock Text="General" Classes="section-title"/><TextBlock Text="Application settings will expand here as TCM+ grows." Classes="muted"/><TextBlock Text="Lock-screen blur" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}"/><TextBlock Text="Adjust how strongly the treatment centre is obscured while locked." Classes="muted" TextWrapping="Wrap"/><Grid ColumnDefinitions="*,Auto" ColumnSpacing="12"><Slider Minimum="4" Maximum="20" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding LockBlurRadius, Mode=TwoWay}"/><TextBlock Grid.Column="1" Text="{Binding LockBlurRadius, StringFormat={}{0:0}px}" Foreground="{StaticResource DeepSeaBrush}" VerticalAlignment="Center"/></Grid><TextBlock Text="{Binding ApplicationVersion, StringFormat=TCM+ {0}}" Foreground="{StaticResource DeepSeaBrush}"/></StackPanel><StackPanel IsVisible="{Binding IsSettingsOperations}" Spacing="12"><TextBlock Text="Operations" Classes="section-title"/><TextBlock Text="Discharge routes" Classes="muted"/><ListBox ItemsSource="{Binding DischargeRoutes}"><ListBox.ItemTemplate><DataTemplate><Grid ColumnDefinitions="*,Auto" Margin="0,4"><TextBlock Text="{Binding}" VerticalAlignment="Center"/><Button Grid.Column="1" Classes="danger" Content="Remove" Command="{Binding DataContext.RemoveDischargeRouteCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/></Grid></DataTemplate></ListBox.ItemTemplate></ListBox><StackPanel Orientation="Horizontal" Spacing="8"><TextBox Text="{Binding NewDischargeRoute}" Width="260" PlaceholderText="New discharge route"/><Button Classes="primary" Content="Add route" Command="{Binding AddDischargeRouteCommand}"/></StackPanel><TextBlock Text="Keep at least one route." Classes="muted"/></StackPanel><ScrollViewer IsVisible="{Binding IsSettingsDisplays}" VerticalScrollBarVisibility="Auto"><StackPanel Spacing="14"><TextBlock Text="Displays" Classes="section-title"/><TextBlock Text="Open a fullscreen read-only display on the next connected monitor." Classes="muted" TextWrapping="Wrap"/><Button Classes="primary" Content="Open Dashboard display" Command="{Binding OpenExternalDisplayCommand}" CommandParameter="Dashboard"/><Button Classes="secondary" Content="Open Map mirror" Command="{Binding OpenExternalDisplayCommand}" CommandParameter="Map"/><Separator/><TextBlock Text="LAN web display" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}"/><TextBlock Text="Start a read-only Dashboard and Map mirror for browsers on this local network. Windows Firewall may ask you to allow access." Classes="muted" TextWrapping="Wrap"/><Button IsVisible="{Binding IsLanDisplayStopped}" Classes="primary" Content="Start LAN web display" Command="{Binding StartLanDisplayCommand}"/><StackPanel IsVisible="{Binding IsLanDisplayRunning}" Spacing="10"><TextBlock Text="{Binding LanDisplayStatus}" Classes="muted" TextWrapping="Wrap"/><TextBlock Text="Viewer PIN" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}"/><TextBlock Text="{Binding LanDisplayPin}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource DeepSeaBrush}"/><ItemsControl ItemsSource="{Binding LanDisplayAddresses}"><ItemsControl.ItemTemplate><DataTemplate><StackPanel Spacing="4" Margin="0,4"><TextBlock Text="{Binding Host}" FontWeight="SemiBold"/><TextBlock Text="Dashboard" Classes="muted"/><TextBox Text="{Binding DashboardUrl}" IsReadOnly="True"/><TextBlock Text="Map" Classes="muted"/><TextBox Text="{Binding MapUrl}" IsReadOnly="True"/></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><Button Classes="danger" Content="Stop LAN web display" Command="{Binding StopLanDisplayCommand}"/></StackPanel></StackPanel></ScrollViewer></Grid></Border>
        </Grid>

        <ScrollViewer Grid.Row="2" Margin="28" IsVisible="{Binding IsDashboard}" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="16">
                <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="16">
                    <Border Classes="card" Padding="18"><StackPanel Spacing="5"><TextBlock Text="{Binding AvailableStations}" FontSize="30" FontWeight="Bold" Foreground="{StaticResource OpenBrush}" /><TextBlock Text="Available stations" Classes="muted" /></StackPanel></Border>
                    <Border Grid.Column="1" Classes="card" Padding="18"><StackPanel Spacing="5"><TextBlock Text="{Binding OccupiedStations}" FontSize="30" FontWeight="Bold" Foreground="{StaticResource ClosedBrush}" /><TextBlock Text="Occupied stations" Classes="muted" /></StackPanel></Border>
                    <Border Grid.Column="2" Classes="card" Padding="18"><StackPanel Spacing="5"><TextBlock Text="{Binding PatientsSeenThisShift}" FontSize="30" FontWeight="Bold" Foreground="{StaticResource DeepSeaBrush}" /><TextBlock Text="Patients seen this shift" Classes="muted" TextWrapping="Wrap" /></StackPanel></Border>
                    <Border Grid.Column="3" Classes="card" Padding="18"><StackPanel Spacing="5"><TextBlock Text="{Binding AverageDischargeText}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource SeaBrush}" /><TextBlock Text="Average discharge time" Classes="muted" TextWrapping="Wrap" /></StackPanel></Border>
                </Grid>
                <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                    <Border Classes="card" Padding="20"><Grid><StackPanel IsVisible="{Binding HasComplaintBreakdown}" Spacing="8"><TextBlock Text="Presenting complaints" Classes="section-title" /><Grid ColumnDefinitions="1.15*,*" ColumnSpacing="14"><charts:DashboardPieChart Slices="{Binding ComplaintBreakdown}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" /><ItemsControl Grid.Column="1" ItemsSource="{Binding ComplaintBreakdown}"><ItemsControl.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal" Spacing="6" Margin="0,4"><Ellipse Width="9" Height="9" Fill="{Binding Color}" VerticalAlignment="Center" /><TextBlock Text="{Binding Label}" Foreground="{StaticResource InkBrush}" TextWrapping="Wrap" /><TextBlock Text="{Binding Value}" Classes="muted" /></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></Grid></StackPanel><StackPanel IsVisible="{Binding HasNoComplaintBreakdown}" VerticalAlignment="Center" HorizontalAlignment="Center"><TextBlock Text="Presenting complaints" Classes="section-title" HorizontalAlignment="Center" /><TextBlock Text="No recorded complaints yet." Classes="muted" Margin="0,8,0,0" /></StackPanel></Grid></Border>
                    <Border Grid.Column="1" Classes="card" Padding="20"><Grid><StackPanel IsVisible="{Binding HasDischargeRouteBreakdown}" Spacing="8"><TextBlock Text="Discharge routes" Classes="section-title" /><Grid ColumnDefinitions="1.15*,*" ColumnSpacing="14"><charts:DashboardPieChart Slices="{Binding DischargeRouteBreakdown}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" /><ItemsControl Grid.Column="1" ItemsSource="{Binding DischargeRouteBreakdown}"><ItemsControl.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal" Spacing="6" Margin="0,4"><Ellipse Width="9" Height="9" Fill="{Binding Color}" VerticalAlignment="Center" /><TextBlock Text="{Binding Label}" Foreground="{StaticResource InkBrush}" TextWrapping="Wrap" /><TextBlock Text="{Binding Value}" Classes="muted" /></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></Grid></StackPanel><StackPanel IsVisible="{Binding HasNoDischargeRouteBreakdown}" VerticalAlignment="Center" HorizontalAlignment="Center"><TextBlock Text="Discharge routes" Classes="section-title" HorizontalAlignment="Center" /><TextBlock Text="No discharges recorded yet." Classes="muted" Margin="0,8,0,0" /></StackPanel></Grid></Border>
                </Grid>
                <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                    <Border Classes="card" Padding="20"><Grid><StackPanel IsVisible="{Binding HasThroughput}"><TextBlock Text="Discharges per hour" Classes="section-title" /><TextBlock Text="{Binding AverageThroughputText}" Classes="muted" Margin="0,3,0,8" /><charts:DashboardTrendChart Points="{Binding ThroughputPoints}" Height="220" LineBrush="#3B6064" /></StackPanel><StackPanel IsVisible="{Binding HasNoThroughput}" VerticalAlignment="Center" HorizontalAlignment="Center"><TextBlock Text="Discharges per hour" Classes="section-title" /><TextBlock Text="No discharges yet." Classes="muted" Margin="0,8,0,0" /></StackPanel></Grid></Border>
                    <Border Grid.Column="1" Classes="card" Padding="20"><Grid><StackPanel IsVisible="{Binding HasDischargeDurations}"><TextBlock Text="Discharge duration" Classes="section-title" /><TextBlock Text="Minutes from arrival to discharge" Classes="muted" Margin="0,3,0,8" /><charts:DashboardTrendChart Points="{Binding DischargeDurationPoints}" Height="220" LineBrush="#B94B4B" /></StackPanel><StackPanel IsVisible="{Binding HasNoDischargeDurations}" VerticalAlignment="Center" HorizontalAlignment="Center"><TextBlock Text="Discharge duration" Classes="section-title" /><TextBlock Text="No completed visits yet." Classes="muted" Margin="0,8,0,0" /></StackPanel></Grid></Border>
                </Grid>
            </StackPanel>
        </ScrollViewer>
            </Grid>
        </Border>

        <Border Classes="banner" IsVisible="{Binding IsBannerVisible}" ZIndex="90" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,12,0,0" Padding="16,8">
            <StackPanel Orientation="Horizontal" Spacing="10"><TextBlock Text="{Binding BannerText}" Foreground="#364958" FontWeight="SemiBold" VerticalAlignment="Center" /><Ellipse Classes="notification-info" Classes.notification-info="{Binding IsNotificationInfo}" Classes.notification-warning="{Binding IsNotificationWarning}" Classes.notification-error="{Binding IsNotificationError}" Width="10" Height="10" VerticalAlignment="Center" /></StackPanel>
        </Border>

        <Border IsVisible="{Binding IsLocked}" ZIndex="100" Background="#364958B8">
            <Border Width="520" HorizontalAlignment="Center" VerticalAlignment="Center" Background="White" BorderBrush="#87BBA2" BorderThickness="1" CornerRadius="14" Padding="30" BoxShadow="0 16 48 0 #00000055">
                <StackPanel Spacing="15">
                    <TextBlock Text="Secure PIN verification" FontSize="21" FontWeight="Bold" Foreground="#364958" HorizontalAlignment="Center" />
                    <TextBlock Text="Enter this shift's six-digit security code." Classes="muted" HorizontalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="9">
                        <TextBox Name="UnlockDigitBox1" Text="{Binding UnlockDigit1, Mode=TwoWay}" MaxLength="1" PasswordChar="*" Width="42" MinWidth="0" Height="48" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" FontSize="20" TextChanged="OnUnlockDigitChanged" KeyDown="OnUnlockDigitKeyDown" />
                        <TextBox Name="UnlockDigitBox2" Text="{Binding UnlockDigit2, Mode=TwoWay}" MaxLength="1" PasswordChar="*" Width="42" MinWidth="0" Height="48" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" FontSize="20" TextChanged="OnUnlockDigitChanged" KeyDown="OnUnlockDigitKeyDown" />
                        <TextBox Name="UnlockDigitBox3" Text="{Binding UnlockDigit3, Mode=TwoWay}" MaxLength="1" PasswordChar="*" Width="42" MinWidth="0" Height="48" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" FontSize="20" TextChanged="OnUnlockDigitChanged" KeyDown="OnUnlockDigitKeyDown" />
                        <TextBox Name="UnlockDigitBox4" Text="{Binding UnlockDigit4, Mode=TwoWay}" MaxLength="1" PasswordChar="*" Width="42" MinWidth="0" Height="48" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" FontSize="20" TextChanged="OnUnlockDigitChanged" KeyDown="OnUnlockDigitKeyDown" />
                        <TextBox Name="UnlockDigitBox5" Text="{Binding UnlockDigit5, Mode=TwoWay}" MaxLength="1" PasswordChar="*" Width="42" MinWidth="0" Height="48" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" FontSize="20" TextChanged="OnUnlockDigitChanged" KeyDown="OnUnlockDigitKeyDown" />
                        <TextBox Name="UnlockDigitBox6" Text="{Binding UnlockDigit6, Mode=TwoWay}" MaxLength="1" PasswordChar="*" Width="42" MinWidth="0" Height="48" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" FontSize="20" TextChanged="OnUnlockDigitChanged" KeyDown="OnUnlockDigitKeyDown" />
                    </StackPanel>
                    <TextBlock Text="{Binding LockMessage}" Foreground="#963D3D" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" />
                    <Button Classes="primary" Content="Unlock" Command="{Binding UnlockCommand}" HorizontalAlignment="Center" />
                    <Button Classes="secondary" Content="Load or switch shift" Command="{Binding RequestSessionSwitchCommand}" HorizontalAlignment="Center" />
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</Window>
