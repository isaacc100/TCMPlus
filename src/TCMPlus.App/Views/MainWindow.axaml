<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:TCMPlus.App.ViewModels"
        xmlns:controls="using:TCMPlus.App.Controls"
        xmlns:charts="using:TCMPlus.App.Controls"
        xmlns:dnd="clr-namespace:Avalonia.Input;assembly=Avalonia.Base"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="820"
        x:Class="TCMPlus.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        x:CompileBindings="False"
        Icon="/Assets/avalonia-logo.ico"
        Title="TCM+"
        WindowDecorations="None"
        ExtendClientAreaToDecorationsHint="False"
        Width="1280"
        Height="820"
        MinWidth="1024"
        MinHeight="600"
        KeyDown="OnKeyDown"
        Background="{StaticResource CanvasBrush}">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <Window.Styles>
        <Style Selector="Button">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.primary-nav">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="#C9E4CA" />
            <Setter Property="Padding" Value="16,10" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>
        <Style Selector="Button.primary-nav.active">
            <Setter Property="Background" Value="#55828B" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="Button.primary-nav:pointerover">
            <Setter Property="Background" Value="#FFFFFF18" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="Button.primary-nav:pressed">
            <Setter Property="Background" Value="#55828B" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="Button.icon">
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="44" />
            <Setter Property="MinHeight" Value="44" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="17" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.icon:pointerover">
            <Setter Property="Background" Value="#FFFFFF22" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="Button.sub-nav">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="#3B6064" />
            <Setter Property="Padding" Value="13,8" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>
        <Style Selector="Button.sub-nav.active">
            <Setter Property="Background" Value="#E7F5EC" />
            <Setter Property="Foreground" Value="#245A42" />
        </Style>
        <Style Selector="Button.sub-nav:pointerover">
            <Setter Property="Background" Value="#E7F5EC" />
            <Setter Property="Foreground" Value="#245A42" />
        </Style>
        <Style Selector="Button.sub-nav:pressed">
            <Setter Property="Background" Value="#E7F5EC" />
            <Setter Property="Foreground" Value="#245A42" />
        </Style>
        <Style Selector="ComboBox.settings-select">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="MinWidth" Value="220" />
        </Style>
        <Style Selector="Button.primary">
            <Setter Property="Background" Value="#3B6064" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="14,9" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>
        <Style Selector="Button.secondary">
            <Setter Property="Background" Value="#E7F5EC" />
            <Setter Property="Foreground" Value="#245A42" />
            <Setter Property="BorderBrush" Value="#87BBA2" />
            <Setter Property="Padding" Value="13,8" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>
        <Style Selector="Button.secondary:disabled">
            <Setter Property="Background" Value="#EDF1EF" />
            <Setter Property="Foreground" Value="#718087" />
            <Setter Property="BorderBrush" Value="#C7D3CD" />
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="Button.danger">
            <Setter Property="Background" Value="#FCEAEA" />
            <Setter Property="Foreground" Value="#963D3D" />
            <Setter Property="BorderBrush" Value="#E5A0A0" />
            <Setter Property="Padding" Value="13,8" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>
        <Style Selector="Button.danger:disabled">
            <Setter Property="Background" Value="#F6EEEE" />
            <Setter Property="Foreground" Value="#8E7474" />
            <Setter Property="BorderBrush" Value="#D8C4C4" />
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="Border.card">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#D5E2DA" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
        </Style>
        <Style Selector="Border.station-table-row.order-target">
            <Setter Property="Background" Value="#E7F5EC" />
            <Setter Property="BorderBrush" Value="#3B6064" />
            <Setter Property="BorderThickness" Value="0,2,0,0" />
        </Style>
        <Style Selector="Border.station-table-row.order-target.order-after">
            <Setter Property="BorderThickness" Value="0,0,0,2" />
        </Style>
        <Style Selector="TextBlock.muted">
            <Setter Property="Foreground" Value="#60737A" />
        </Style>
        <Style Selector="TextBlock.section-title">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="#364958" />
        </Style>
        <Style Selector="Border.banner">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="BoxShadow" Value="0 6 20 0 #00000033" />
        </Style>
        <Style Selector="Ellipse.notification-info"><Setter Property="Fill" Value="#55828B" /></Style>
        <Style Selector="Ellipse.notification-warning"><Setter Property="Fill" Value="#D39B28" /></Style>
        <Style Selector="Ellipse.notification-error"><Setter Property="Fill" Value="#B94B4B" /></Style>
    </Window.Styles>

    <Grid>
        <Border>
            <Border.Effect><BlurEffect Radius="{Binding ActiveBlurRadius}" /></Border.Effect>
            <Grid RowDefinitions="Auto,Auto,*">
        <Border Background="{StaticResource InkBrush}" Height="66" Padding="16,0" PointerPressed="OnAppHeaderPointerPressed">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                <StackPanel VerticalAlignment="Center" Spacing="1">
                    <TextBlock Text="TCM+" Foreground="White" FontSize="22" FontWeight="Bold" />
                    <TextBlock Text="{Binding InstanceModeText}" Foreground="#D9E9E1" FontSize="10" MaxWidth="180" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="3">
                    <Button Classes="primary-nav" Classes.active="{Binding IsDashboard}" Content="Overview" Command="{Binding ShowDashboardCommand}" />
                    <Button Classes="primary-nav" Classes.active="{Binding IsManager}" Content="Treatment centre" Command="{Binding ShowManagerCommand}" />
                    <Button Classes="primary-nav" Classes.active="{Binding IsPatientsPage}" Content="Patients" Command="{Binding ShowPatientsCommand}" IsVisible="{Binding CanAdministerHost}" />
                    <Button Classes="primary-nav" Classes.active="{Binding IsSetupPage}" Content="Shift setup" Command="{Binding ShowSetupCommand}" IsVisible="{Binding CanAdministerHost}" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="4">
                    <TextBlock Text="{Binding CurrentTimeText}" Foreground="White" FontFamily="Consolas" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,4,0" />
                    <Button Classes="icon" Click="OnFullScreenClicked" ToolTip.Tip="Toggle fullscreen">
                        <PathIcon Data="M 3,3 L 9,3 L 9,5 L 5,5 L 5,9 L 3,9 Z M 11,3 L 17,3 L 17,9 L 15,9 L 15,5 L 11,5 Z M 15,11 L 17,11 L 17,17 L 11,17 L 11,15 L 15,15 Z M 3,11 L 5,11 L 5,15 L 9,15 L 9,17 L 3,17 Z" Foreground="White" Width="18" Height="18" />
                    </Button>
                    <Button Classes="icon" Command="{Binding LockCommand}" ToolTip.Tip="Lock application" IsVisible="{Binding CanLock}">
                        <PathIcon Data="M 5,8 L 7,8 L 7,6 C 7,2 13,2 13,6 L 13,8 L 15,8 L 15,18 L 5,18 Z M 9,8 L 11,8 L 11,6 C 11,4 9,4 9,6 Z" Foreground="White" Width="18" Height="18" />
                    </Button>
                    <Button Classes="icon" Command="{Binding ShowSettingsCommand}" ToolTip.Tip="Application settings">
                        <PathIcon Data="M 3,4 L 6,4 L 6,2 L 8,2 L 8,4 L 17,4 L 17,6 L 8,6 L 8,8 L 6,8 L 6,6 L 3,6 Z M 3,9 L 12,9 L 12,7 L 14,7 L 14,9 L 17,9 L 17,11 L 14,11 L 14,13 L 12,13 L 12,11 L 3,11 Z M 3,14 L 7,14 L 7,12 L 9,12 L 9,14 L 17,14 L 17,16 L 9,16 L 9,18 L 7,18 L 7,16 L 3,16 Z" Foreground="White" Width="18" Height="18" />
                    </Button>
                    <Button Classes="icon" Click="OnSafeExitClicked" ToolTip.Tip="Seal this shift and exit TCM+">
                        <PathIcon Data="M 9,2 L 11,2 L 11,11 L 9,11 Z M 5.2,4.3 L 6.6,5.8 C 4.9,6.9 4,8.6 4,10.5 C 4,13.8 6.7,16.5 10,16.5 C 13.3,16.5 16,13.8 16,10.5 C 16,8.6 15.1,6.9 13.4,5.8 L 14.8,4.3 C 16.8,5.8 18,8 18,10.5 C 18,14.9 14.4,18.5 10,18.5 C 5.6,18.5 2,14.9 2,10.5 C 2,8 3.2,5.8 5.2,4.3 Z" Foreground="White" Width="18" Height="18" />
                    </Button>
                    <controls:WindowControlButtons />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" IsVisible="{Binding IsManager}" Background="White" BorderBrush="#D5E2DA" BorderThickness="0,0,0,1" Padding="28,8">
            <Grid ColumnDefinitions="*,Auto"><StackPanel Orientation="Horizontal" Spacing="4">
                    <Button Classes="sub-nav" Classes.active="{Binding IsMapPage}" Content="Map" Command="{Binding ShowMapCommand}" />
                    <Button Classes="sub-nav" Classes.active="{Binding IsTablesPage}" Content="Stations" Command="{Binding ShowTablesCommand}" />
                    <Button Classes="sub-nav" Classes.active="{Binding IsTeamsPage}" Content="Teams" Command="{Binding ShowTeamsCommand}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <TextBlock Text="Rapid Entry" Foreground="{StaticResource InkBrush}" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <ToggleSwitch IsChecked="{Binding QuickEntry, Mode=TwoWay}"
                                  ToolTip.Tip="Adds or removes a patient in one action without opening the details or discharge dialog." />
                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center" IsVisible="{Binding IsTerminal}">
                        <TextBlock Text="{Binding TerminalConnectionStatus}" Classes="muted" MaxWidth="360" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding PendingTerminalCommands, StringFormat=Queued: {0}}" Foreground="#765617" IsVisible="{Binding HasPendingTerminalCommands}"/>
                        <TextBlock Text="{Binding RejectedTerminalCommands, StringFormat=Rejected: {0}}" Foreground="#963D3D"
                                   IsVisible="{Binding HasRejectedTerminalCommands}" ToolTip.Tip="{Binding TerminalQueueReviewText}"/>
                        <Button Content="Acknowledge" Command="{Binding AcknowledgeRejectedTerminalCommandsCommand}" IsVisible="{Binding HasRejectedTerminalCommands}"/>
                        <TextBlock Text="{Binding UnresolvedTerminalCommands, StringFormat=Unresolved: {0}}" Foreground="#963D3D"
                                   IsVisible="{Binding HasUnresolvedTerminalCommands}" ToolTip.Tip="{Binding TerminalQueueReviewText}"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <Grid x:Name="ManagerMapGrid" Grid.Row="2" Margin="28" IsVisible="{Binding IsMapPage}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="320"/>
            </Grid.ColumnDefinitions>
            <Border Classes="card" Padding="18">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="18">
                    <TextBlock Text="Treatment centre" Classes="section-title" />
                    <StackPanel Spacing="8" IsVisible="{Binding IsOperationalMode}">
                        <TextBlock Text="{Binding AvailableStations}" FontSize="34" FontWeight="Bold" Foreground="{StaticResource OpenBrush}" />
                        <TextBlock Text="Available stations" Classes="muted" />
                    </StackPanel>
                    <StackPanel Spacing="8" IsVisible="{Binding IsOperationalMode}">
                        <TextBlock Text="{Binding OccupiedStations}" FontSize="34" FontWeight="Bold" Foreground="{StaticResource ClosedBrush}" />
                        <TextBlock Text="Occupied stations" Classes="muted" />
                    </StackPanel>
                    <StackPanel Spacing="8" IsVisible="{Binding IsOperationalMode}">
                        <TextBlock Text="{Binding PatientsSeenThisShift}" FontSize="34" FontWeight="Bold" Foreground="{StaticResource DeepSeaBrush}" />
                        <TextBlock Text="Patients seen this shift" Classes="muted" TextWrapping="Wrap" />
                    </StackPanel>
                    <Button Classes="secondary" Content="Edit Treatment Centre" Command="{Binding ToggleEditModeCommand}" Margin="0,10,0,0" IsVisible="{Binding IsOperationalMode}" />
                    <Button Classes="primary" Content="Add station" Command="{Binding RequestAddStationCommand}" IsVisible="{Binding IsEditMode}" />
                    <StackPanel Spacing="8" IsVisible="{Binding IsEditMode}">
                        <Border Background="#FFF2C7" BorderBrush="#C78C1C" BorderThickness="1" CornerRadius="8" Padding="10">
                            <TextBlock Text="LAYOUT EDITING — changes remain a draft until saved." TextWrapping="Wrap" FontWeight="Bold" Foreground="#614400"/>
                        </Border>
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                            <Button Classes="secondary" Content="Undo" Command="{Binding UndoLayoutCommand}" IsEnabled="{Binding CanUndoLayout}"/>
                            <Button Grid.Column="1" Classes="secondary" Content="Redo" Command="{Binding RedoLayoutCommand}" IsEnabled="{Binding CanRedoLayout}"/>
                        </Grid>
                        <Button Classes="primary" Content="Save layout" Command="{Binding SaveLayoutCommand}" />
                        <Button Classes="secondary" Content="Discard changes" Command="{Binding DiscardLayoutCommand}" />
                        <TextBlock Text="Map size" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" />
                        <Button Classes="secondary" Content="Compact 50 by 30" Command="{Binding SetCompactDensityCommand}" />
                        <Button Classes="secondary" Content="Standard 60 by 36" Command="{Binding SetStandardDensityCommand}" />
                        <Button Classes="secondary" Content="Dense 75 by 45" Command="{Binding SetDenseDensityCommand}" />
                    </StackPanel>
                    <Button Classes="secondary" Content="View all teams" Command="{Binding ShowTeamsCommand}" IsVisible="{Binding IsOperationalMode}" />
                    <Button Classes="primary" Content="Add mobile team" Command="{Binding RequestAddMobileTeamCommand}" IsVisible="{Binding IsOperationalMode}" />
                </StackPanel>
                </ScrollViewer>
            </Border>

            <Grid x:Name="StationMapHost" Grid.Column="2">
                <Border x:Name="StationMapCard" Classes="card" Padding="0" ClipToBounds="True"
                        HorizontalAlignment="Center" VerticalAlignment="Stretch">
                    <Grid RowDefinitions="*,Auto">
                        <Border Background="#EEF5EF" Padding="18,14" MinHeight="76"
                                BorderBrush="#D5E2DA" BorderThickness="0,0,0,1">
                            <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Station map" Classes="section-title" />
                                    <TextBlock Text="{Binding MapStatusText}" Classes="muted" TextWrapping="Wrap" MaxLines="2" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                                    <Button x:Name="MobileTeamDrawerButton" Classes="secondary" Content="{Binding DeployedMobileTeams, StringFormat=Mobile teams ({0} deployed)}" Click="OnToggleMobileTeamDrawer" IsVisible="False"/>
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Ellipse Width="9" Height="9" Fill="{StaticResource OpenBrush}" VerticalAlignment="Center" />
                                        <TextBlock Text="Available" Classes="muted" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Ellipse Width="9" Height="9" Fill="{StaticResource ClosedBrush}" VerticalAlignment="Center" />
                                        <TextBlock Text="Occupied" Classes="muted" />
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Viewbox x:Name="StationMapViewport" Grid.Row="1" Stretch="Uniform"
                                 HorizontalAlignment="Center" VerticalAlignment="Bottom">
                            <Grid Width="1200" Height="720">
                                <Border Background="#FFF7D6" Opacity="0.62" IsVisible="{Binding IsEditMode}"/>
                                <controls:DotGridControl Spacing="{Binding GridPixelSize}" />
                                <ItemsControl ItemsSource="{Binding Stations}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <Canvas Width="1200" Height="720" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemContainerTheme>
                                        <ControlTheme x:DataType="vm:StationViewModel" TargetType="ContentPresenter">
                                            <Setter Property="Canvas.Left" Value="{Binding CanvasX}" />
                                            <Setter Property="Canvas.Top" Value="{Binding CanvasY}" />
                                        </ControlTheme>
                                    </ItemsControl.ItemContainerTheme>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <controls:StationCard Width="{Binding CanvasWidth}" Height="{Binding CanvasHeight}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Border IsVisible="{Binding HasNoStations}" Width="320" Height="150" HorizontalAlignment="Center" VerticalAlignment="Center" Background="#FFFFFFDD" BorderBrush="#87BBA2" BorderThickness="1" CornerRadius="10" Padding="20">
                                    <StackPanel Spacing="8" HorizontalAlignment="Center">
                                        <TextBlock Text="No stations configured" FontWeight="Bold" FontSize="17" Foreground="{StaticResource InkBrush}" HorizontalAlignment="Center" />
                                        <TextBlock Text="Edit the treatment centre to add and place the first station." Classes="muted" TextWrapping="Wrap" TextAlignment="Center" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Viewbox>
                    </Grid>
                </Border>
            </Grid>
            <Border x:Name="DockedMobileTeamRail" Grid.Column="4" Classes="card" Padding="0" ClipToBounds="True">
                <Grid RowDefinitions="Auto,*">
                    <Border Background="#EEF5EF" Padding="16,14" BorderBrush="#D5E2DA" BorderThickness="0,0,0,1">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2">
                                <TextBlock Text="Mobile teams" Classes="section-title"/>
                                <TextBlock Text="{Binding DeployedMobileTeams, StringFormat={}{0} deployed}" Classes="muted"/>
                            </StackPanel>
                            <Button Grid.Column="1" Classes="secondary" Content="Add team" Command="{Binding RequestAddMobileTeamCommand}"/>
                        </Grid>
                    </Border>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="12" Spacing="12">
                            <ItemsControl ItemsSource="{Binding MobileTeams}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate><controls:MobileTeamCard Margin="0,0,0,12"/></DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <StackPanel IsVisible="{Binding HasNoMobileTeams}" Spacing="8" Margin="8,24" HorizontalAlignment="Center">
                        <TextBlock Text="No mobile teams configured" FontWeight="Bold" Foreground="{StaticResource InkBrush}" HorizontalAlignment="Center"/>
                                <TextBlock Text="Add a team without leaving Treatment Centre." Classes="muted"
                                           TextAlignment="Center" TextWrapping="Wrap"/>
                                <Button Classes="primary" Content="Add mobile team" Command="{Binding RequestAddMobileTeamCommand}"/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
            <Border x:Name="MobileTeamDrawer" Grid.Column="2" Width="320" HorizontalAlignment="Right" VerticalAlignment="Stretch"
                    Background="White" BorderBrush="#87BBA2" BorderThickness="1" CornerRadius="10"
                    BoxShadow="0 10 30 0 #00000044" IsVisible="False" ZIndex="20" ClipToBounds="True">
                <Grid RowDefinitions="Auto,*">
                    <Border Background="#EEF5EF" Padding="16,12" BorderBrush="#D5E2DA" BorderThickness="0,0,0,1">
                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
                            <StackPanel>
                                <TextBlock Text="Mobile teams" Classes="section-title"/>
                                <TextBlock Text="{Binding DeployedMobileTeams, StringFormat={}{0} deployed}" Classes="muted"/>
                            </StackPanel>
                            <Button Grid.Column="1" Classes="secondary" Content="Add team" Command="{Binding RequestAddMobileTeamCommand}"/>
                            <Button Grid.Column="2" Classes="secondary" Content="Close" Click="OnCloseMobileTeamDrawer"/>
                        </Grid>
                    </Border>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="12" Spacing="12">
                            <ItemsControl ItemsSource="{Binding MobileTeams}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate><controls:MobileTeamCard Margin="0,0,0,12"/></DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <StackPanel IsVisible="{Binding HasNoMobileTeams}" Spacing="8" Margin="8,24">
                                <TextBlock Text="No mobile teams configured." Classes="muted" TextWrapping="Wrap" TextAlignment="Center"/>
                                <Button Classes="primary" Content="Add mobile team" Command="{Binding RequestAddMobileTeamCommand}"/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="2" Margin="28" IsVisible="{Binding IsTablesPage}" RowDefinitions="Auto,16,Auto,16,*">
            <Border Classes="card" Padding="20">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Stations" Classes="section-title" />
                        <TextBlock Text="Review stations and use the mobile-team panel here without leaving Treatment Centre." Classes="muted" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Button Classes="secondary" Content="Edit Treatment Centre" Command="{Binding ToggleEditModeCommand}" IsVisible="{Binding IsOperationalMode}" />
                        <Button Classes="primary" Content="Add station" Command="{Binding RequestAddStationCommand}" IsVisible="{Binding IsEditMode}" />
                        <Button Classes="secondary" Content="Undo" Command="{Binding UndoLayoutCommand}" IsVisible="{Binding IsEditMode}" IsEnabled="{Binding CanUndoLayout}" />
                        <Button Classes="secondary" Content="Redo" Command="{Binding RedoLayoutCommand}" IsVisible="{Binding IsEditMode}" IsEnabled="{Binding CanRedoLayout}" />
                        <Button Classes="primary" Content="Save layout" Command="{Binding SaveLayoutCommand}" IsVisible="{Binding IsEditMode}" />
                        <Button Classes="secondary" Content="Discard" Command="{Binding DiscardLayoutCommand}" IsVisible="{Binding IsEditMode}" />
                    </StackPanel>
                </Grid>
            </Border>
            <Border Grid.Row="2" Classes="card" Padding="0" ClipToBounds="True" MaxHeight="270">
                <Grid RowDefinitions="Auto,*">
                    <Border Background="#EEF5EF" Padding="18,12" BorderBrush="#D5E2DA" BorderThickness="0,0,0,1">
                        <Grid ColumnDefinitions="1.1*,110,1.1*,1.1*,120,Auto" ColumnSpacing="8">
                            <StackPanel>
                                <TextBlock Text="Mobile teams" FontWeight="Bold" Foreground="{StaticResource InkBrush}"/>
                                <TextBlock Text="{Binding DeployedMobileTeams, StringFormat={}{0} deployed}" Classes="muted" FontSize="11"/>
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="State" FontWeight="Bold" Foreground="{StaticResource InkBrush}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="Location" FontWeight="Bold" Foreground="{StaticResource InkBrush}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="3" Text="Note" FontWeight="Bold" Foreground="{StaticResource InkBrush}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="4" Text="Patient" FontWeight="Bold" Foreground="{StaticResource InkBrush}" VerticalAlignment="Center"/>
                            <Button Grid.Column="5" Classes="secondary" Content="Add team" Command="{Binding RequestAddMobileTeamCommand}"/>
                        </Grid>
                    </Border>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <ItemsControl ItemsSource="{Binding MobileTeams}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="White" Padding="18,10" BorderBrush="#E5ECE7" BorderThickness="0,0,0,1"
                                                dnd:DragDrop.AllowDrop="True"
                                                dnd:DragDrop.DragOver="OnMobileTeamRowDragOver"
                                                dnd:DragDrop.DragLeave="OnMobileTeamRowDragLeave"
                                                dnd:DragDrop.Drop="OnMobileTeamRowDrop">
                                            <Grid ColumnDefinitions="1.1*,110,1.1*,1.1*,120,Auto" ColumnSpacing="8">
                                                <TextBlock Text="{Binding Callsign}" FontWeight="Bold" Foreground="{StaticResource InkBrush}" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="{Binding StatusText}" Foreground="{StaticResource OpenBrush}" FontWeight="Bold" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="2" Text="{Binding LocationText}" Classes="muted" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="3" Text="{Binding NoteText}" Classes="muted" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                                <Border Grid.Column="4" IsVisible="{Binding IsOccupied}" Background="#364958" CornerRadius="6" Padding="8,5"
                                                        PointerPressed="OnTablePatientPointerPressed" Cursor="Hand" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal" Spacing="6"><PathIcon Data="M3,7H21V9H3V7M3,11H21V13H3V11M3,15H21V17H3V15" Width="16" Height="16" Foreground="White"/><TextBlock Text="{Binding PatientCounterText}" Foreground="White" FontWeight="Bold"/></StackPanel>
                                                </Border>
                                                <WrapPanel Grid.Column="5" Orientation="Horizontal">
                                                    <Button Classes="secondary" Content="Deploy" Command="{Binding DeployCommand}" IsVisible="{Binding IsAvailable}" Margin="0,0,6,4"/>
                                                    <Button Classes="secondary" Content="Location" Command="{Binding EditLocationCommand}" IsVisible="{Binding IsDeployed}" Margin="0,0,6,4"/>
                                                    <Button Classes="secondary" Content="Add patient" Command="{Binding AddPatientCommand}" IsVisible="{Binding CanAddPatient}" Margin="0,0,6,4"/>
                                                    <Button Classes="secondary" Content="Transfer" Command="{Binding TransferPatientCommand}" IsVisible="{Binding IsOccupied}" Margin="0,0,6,4"/>
                                                    <Button Classes="danger" Content="Discharge" Command="{Binding DischargePatientCommand}" IsVisible="{Binding IsOccupied}" Margin="0,0,6,4"/>
                                                    <Button Classes="secondary" Content="Stand down" Command="{Binding StandDownCommand}" IsVisible="{Binding IsDeployed}" Margin="0,0,0,4"/>
                                                </WrapPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <StackPanel IsVisible="{Binding HasNoMobileTeams}" HorizontalAlignment="Center" Margin="18" Spacing="8">
                                <TextBlock Text="No mobile teams configured." Classes="muted"/>
                                <Button Classes="primary" Content="Add mobile team" Command="{Binding RequestAddMobileTeamCommand}"/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
            <Border Grid.Row="4" Classes="card" Padding="0" ClipToBounds="True">
                <ScrollViewer HorizontalScrollBarVisibility="Auto">
                    <StackPanel MinWidth="760">
                        <Border Background="#EEF5EF" Padding="18,13">
                            <Grid ColumnDefinitions="36,1.4*,1.15*,130,1.25*,Auto">
                                <TextBlock Grid.Column="1" Text="Station" FontWeight="Bold" Foreground="{StaticResource InkBrush}" />
                                <TextBlock Grid.Column="2" Text="Type" FontWeight="Bold" Foreground="{StaticResource InkBrush}" />
                                <TextBlock Grid.Column="3" Text="State" FontWeight="Bold" Foreground="{StaticResource InkBrush}" />
                                <TextBlock Grid.Column="4" Text="Added" FontWeight="Bold" Foreground="{StaticResource InkBrush}" />
                            </Grid>
                        </Border>
                        <ItemsControl ItemsSource="{Binding Stations}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Classes="station-table-row"
                                            Classes.order-target="{Binding IsStationOrderDropTarget}"
                                            Classes.order-after="{Binding IsStationOrderDropAfter}"
                                            Background="White"
                                            Padding="18,13"
                                            dnd:DragDrop.AllowDrop="True"
                                            dnd:DragDrop.DragOver="OnStationOrderDragOver"
                                            dnd:DragDrop.DragLeave="OnStationOrderDragLeave"
                                            dnd:DragDrop.Drop="OnStationOrderDrop">
                                        <Grid ColumnDefinitions="36,1.4*,1.15*,130,1.25*,Auto" ColumnSpacing="8">
                                            <Grid.Styles>
                                                <Style Selector="TextBlock.status">
                                                    <Setter Property="Foreground" Value="#2F8F61" />
                                                    <Setter Property="FontWeight" Value="Bold" />
                                                </Style>
                                                <Style Selector="TextBlock.status.occupied">
                                                    <Setter Property="Foreground" Value="#B94B4B" />
                                                </Style>
                                            </Grid.Styles>
                                            <PathIcon Data="M3,7H21V9H3V7M3,11H21V13H3V11M3,15H21V17H3V15" Width="20" Height="20" Foreground="{StaticResource SeaBrush}" Cursor="Hand" IsVisible="{Binding IsEditMode}" VerticalAlignment="Center" HorizontalAlignment="Center" PointerPressed="OnStationOrderPointerPressed" ToolTip.Tip="Drag to reorder" />
                                            <TextBlock Grid.Column="1" Text="{Binding Name}" IsVisible="{Binding IsOperationalMode}" VerticalAlignment="Center" Foreground="{StaticResource InkBrush}" FontWeight="SemiBold" />
                                            <StackPanel Grid.Column="1" IsVisible="{Binding IsEditMode}" Spacing="5">
                                                <TextBox Text="{Binding Name}" PlaceholderText="Station name" AutomationProperties.Name="Station name"/>
                                                <WrapPanel Orientation="Horizontal">
                                                    <TextBlock Text="X" VerticalAlignment="Center" Margin="0,0,3,0"/><NumericUpDown Value="{Binding GridX}" Minimum="0" Increment="1" Width="64" AutomationProperties.Name="Station X coordinate"/>
                                                    <TextBlock Text="Y" VerticalAlignment="Center" Margin="7,0,3,0"/><NumericUpDown Value="{Binding GridY}" Minimum="0" Increment="1" Width="64" AutomationProperties.Name="Station Y coordinate"/>
                                                    <TextBlock Text="W" VerticalAlignment="Center" Margin="7,0,3,0"/><NumericUpDown Value="{Binding GridWidth}" Minimum="7" Increment="1" Width="64" AutomationProperties.Name="Station width"/>
                                                    <TextBlock Text="H" VerticalAlignment="Center" Margin="7,0,3,0"/><NumericUpDown Value="{Binding GridHeight}" Minimum="7" Increment="1" Width="64" AutomationProperties.Name="Station height"/>
                                                </WrapPanel>
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="{Binding Type}" IsVisible="{Binding IsOperationalMode}" VerticalAlignment="Center" Classes="muted" />
                                            <TextBox Grid.Column="2" Text="{Binding Type}" IsVisible="{Binding IsEditMode}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="3" Text="{Binding StatusText}" Classes="status" Classes.occupied="{Binding IsOccupied}" VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="4" Spacing="2" VerticalAlignment="Center" PointerPressed="OnTablePatientPointerPressed" Cursor="Hand">
                                                <TextBlock Text="{Binding PatientCounterText}" FontWeight="SemiBold" Foreground="{StaticResource DeepSeaBrush}" />
                                                <TextBlock Text="{Binding PatientArrivalText}" Classes="muted" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="8">
                                                <Button Classes="secondary" Content="Add Patient" Command="{Binding AddPatientCommand}" IsVisible="{Binding CanAddPatient}" />
                                                <Button Classes="secondary" Content="Transfer" Command="{Binding TransferPatientCommand}" IsVisible="{Binding IsOccupied}" />
                                                <Button Classes="danger" Content="Discharge" Command="{Binding DischargePatientCommand}" IsVisible="{Binding CanDischargePatient}" />
                                                <Button Classes="secondary" Content="Save" Command="{Binding SaveStationCommand}" IsVisible="{Binding IsEditMode}" />
                                                <Button Classes="danger" Content="Delete" Command="{Binding DeleteStationCommand}" IsVisible="{Binding IsEditMode}" IsEnabled="{Binding CanDelete}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <Grid Grid.Row="2" Margin="28" IsVisible="{Binding IsTeamsPage}" RowDefinitions="Auto,16,*">
            <Border Classes="card" Padding="20">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Mobile teams" Classes="section-title" />
                        <TextBlock Text="Manage callsigns and complete operational team actions without leaving Treatment Centre." Classes="muted" TextWrapping="Wrap" />
                    </StackPanel>
                    <Button Grid.Column="1" Classes="primary" Content="Add mobile team" Command="{Binding RequestAddMobileTeamCommand}" />
                </Grid>
            </Border>
            <Border Grid.Row="2" Classes="card" Padding="18">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Spacing="14">
                        <ItemsControl ItemsSource="{Binding MobileTeams}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <controls:MobileTeamCard Margin="0,0,0,12" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <StackPanel IsVisible="{Binding HasNoMobileTeams}" Spacing="10" Margin="24" HorizontalAlignment="Center">
                            <TextBlock Text="No mobile teams configured" FontSize="18" FontWeight="Bold" Foreground="{StaticResource InkBrush}" />
                            <TextBlock Text="Add the first callsign for this shift." Classes="muted" />
                            <Button Classes="primary" Content="Add mobile team" Command="{Binding RequestAddMobileTeamCommand}" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <Grid Grid.Row="2" Margin="28" IsVisible="{Binding IsPatientsPage}" RowDefinitions="Auto,16,*">
            <Border Classes="card" Padding="20">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Patients" Classes="section-title" />
                        <TextBlock Text="All patients recorded during this shift. Edit details and recorded times, or select several patients to apply one complaint." Classes="muted" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Button Classes="secondary" Content="Set complaint for selected" Command="{Binding RequestBulkComplaintCommand}" IsVisible="{Binding IsPatientEditMode}" />
                        <Button Classes="secondary" Content="{Binding PatientEditModeText}" Command="{Binding TogglePatientEditModeCommand}" />
                    </StackPanel>
                </Grid>
            </Border>
            <Border Grid.Row="2" Classes="card" Padding="0" ClipToBounds="True">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                    <StackPanel MinWidth="1180">
                        <Border Background="#EEF5EF" Padding="18,13">
                            <Grid ColumnDefinitions="36,82,96,115,135,135,1.2*,1*,1.1*,Auto" ColumnSpacing="8">
                                <TextBlock Grid.Column="1" Text="Patient" FontWeight="Bold" Foreground="{StaticResource InkBrush}" />
                                <TextBlock Grid.Column="2" Text="Status" FontWeight="Bold" Foreground="{StaticResource InkBrush}" />
                                <TextBlock Grid.Column="3" Text="Current location" FontWeight="Bold" Foreground="{StaticResource InkBrush}" />
                                <TextBlock Grid.Column="4" Text="New time" FontWeight="Bold" Foreground="{StaticResource InkBrush}" />
                                <TextBlock Grid.Column="5" Text="Discharge time" FontWeight="Bold" Foreground="{StaticResource InkBrush}" />
                                <TextBlock Grid.Column="6" Text="Presenting complaint" FontWeight="Bold" Foreground="{StaticResource InkBrush}" />
                                <TextBlock Grid.Column="7" Text="Discharge route" FontWeight="Bold" Foreground="{StaticResource InkBrush}" />
                                <TextBlock Grid.Column="8" Text="Outcome" FontWeight="Bold" Foreground="{StaticResource InkBrush}" />
                            </Grid>
                        </Border>
                        <ItemsControl ItemsSource="{Binding Patients}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="White" Padding="18,13">
                                        <Grid ColumnDefinitions="36,82,96,115,135,135,1.2*,1*,1.1*,Auto" ColumnSpacing="8">
                                            <Grid.Styles>
                                                <Style Selector="TextBlock.status"><Setter Property="Foreground" Value="#2F8F61" /><Setter Property="FontWeight" Value="Bold" /></Style>
                                                <Style Selector="TextBlock.status.discharged"><Setter Property="Foreground" Value="#60737A" /></Style>
                                            </Grid.Styles>
                                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" IsVisible="{Binding IsEditMode}" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="{Binding PatientNumber, StringFormat=Patient {0}}" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{StaticResource DeepSeaBrush}" />
                                            <TextBlock Grid.Column="2" Text="{Binding StatusText}" Classes="status" Classes.discharged="{Binding IsDischarged}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="3" Text="{Binding CurrentLocationText}" Classes="muted" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="4" Text="{Binding AddedAtText}" Classes="muted" IsVisible="{Binding IsOperationalMode}" VerticalAlignment="Center" />
                                            <TextBox Grid.Column="4" Text="{Binding AddedAtEditText, Mode=TwoWay}" IsVisible="{Binding IsEditMode}" PlaceholderText="dd/MM/yyyy HH:mm" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="5" Text="{Binding DischargedAtText}" Classes="muted" IsVisible="{Binding ShowReadOnlyDischargeDetails}" VerticalAlignment="Center" />
                                            <TextBox Grid.Column="5" Text="{Binding DischargedAtEditText, Mode=TwoWay}" IsVisible="{Binding CanEditDischargeDetails}" PlaceholderText="dd/MM/yyyy HH:mm" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="6" Text="{Binding PresentingComplaintDisplay}" IsVisible="{Binding IsOperationalMode}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                            <TextBox Grid.Column="6" Text="{Binding PresentingComplaint, Mode=TwoWay}" IsVisible="{Binding IsEditMode}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="7" Text="{Binding DischargeRouteDisplay}" IsVisible="{Binding ShowReadOnlyDischargeDetails}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                            <ComboBox Grid.Column="7" ItemsSource="{Binding DischargeRoutes}" SelectedItem="{Binding DischargeRoute, Mode=TwoWay}" IsVisible="{Binding CanEditDischargeDetails}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="8" Text="{Binding DischargeOutcomeDisplay}" IsVisible="{Binding ShowReadOnlyDischargeDetails}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                            <ComboBox Grid.Column="8" ItemsSource="{Binding DischargeOutcomes}" SelectedItem="{Binding DischargeOutcome, Mode=TwoWay}" IsVisible="{Binding CanEditDischargeDetails}" VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="9" Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsEditMode}">
                                                <Button Classes="secondary" Content="Save" Command="{Binding SaveCommand}" />
                                                <Button Classes="secondary" Content="Cancel" Command="{Binding CancelCommand}" />
                                                <Button Classes="danger" Content="Delete" Command="{Binding DeleteCommand}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="No patients have been recorded for this shift." Classes="muted" IsVisible="{Binding HasNoPatients}" Margin="18,22" HorizontalAlignment="Center" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <Grid Grid.Row="2" Margin="28" IsVisible="{Binding IsSetupPage}">
            <Border Classes="card" Padding="24" Width="720" HorizontalAlignment="Center" VerticalAlignment="Top" IsVisible="{Binding CanAdministerHost}">
                <StackPanel Spacing="16">
                    <TextBlock Text="Shift setup" Classes="section-title" />
                    <TextBlock Text="Shift details" FontWeight="Bold" Foreground="{StaticResource InkBrush}" />
                    <TextBlock Text="Used to identify this shift and name its save folder." Classes="muted" TextWrapping="Wrap" />
                    <TextBox Text="{Binding ShiftName}" PlaceholderText="Shift name" />
                    <Grid ColumnDefinitions="*,Auto"><TextBlock Text="Shift PIN set" Foreground="#2F8F61" VerticalAlignment="Center"/><Button Grid.Column="1" Classes="secondary" Content="Change PIN" Command="{Binding BeginPinChangeCommand}"/></Grid>
                    <TextBox Text="{Binding NewPin}" PasswordChar="*" MaxLength="6" PlaceholderText="New six-digit PIN" IsVisible="{Binding IsChangingPin}" />
                    <Button Classes="primary" Content="Save changes" Command="{Binding SaveShiftPinCommand}" />
                    <TextBlock Text="{Binding PinStatusText}" Classes="muted" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="2" Margin="28" IsVisible="{Binding IsSettings}" ColumnDefinitions="250,18,*">
            <Border Classes="card" Padding="12"><StackPanel Spacing="5"><TextBlock Text="Settings" Classes="section-title" Margin="8,4,0,10"/><Button Classes="sub-nav" Content="Appearance &amp; accessibility" Command="{Binding ShowSettingsGeneralCommand}"/><Button Classes="sub-nav" Content="Operations" Command="{Binding ShowSettingsOperationsCommand}" IsVisible="{Binding CanAdminHost}"/><Button Classes="sub-nav" Content="Displays" Command="{Binding ShowSettingsDisplaysCommand}"/></StackPanel></Border>
            <Border Grid.Column="2" Classes="card" Padding="24">
                <Grid>
                    <ScrollViewer IsVisible="{Binding IsSettingsGeneral}" VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="14">
                            <TextBlock Text="Appearance and accessibility" Classes="section-title"/>
                            <TextBlock Text="These choices apply to this device only. Changes are previewed immediately and do not affect other terminals." Classes="muted" TextWrapping="Wrap"/>
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="18" RowDefinitions="Auto,Auto,Auto,Auto">
                                <StackPanel Grid.Row="0" Spacing="5">
                                    <TextBlock Text="Preset" FontWeight="SemiBold"/>
                                    <ComboBox Classes="settings-select" ItemsSource="{Binding Appearance.Presets}" SelectedItem="{Binding Appearance.SelectedPreset, Mode=TwoWay}" AutomationProperties.Name="Accessibility preset"/>
                                </StackPanel>
                                <StackPanel Grid.Row="0" Grid.Column="1" Spacing="5">
                                    <TextBlock Text="Font" FontWeight="SemiBold"/>
                                    <ComboBox Classes="settings-select" ItemsSource="{Binding Appearance.Fonts}" SelectedItem="{Binding Appearance.Font, Mode=TwoWay}" AutomationProperties.Name="Interface font"/>
                                </StackPanel>
                                <StackPanel Grid.Row="1" Margin="0,12,0,0" Spacing="5">
                                    <TextBlock Text="Text size" FontWeight="SemiBold"/>
                                    <ComboBox Classes="settings-select" ItemsSource="{Binding Appearance.TextScales}" SelectedItem="{Binding Appearance.TextScale, Mode=TwoWay}" AutomationProperties.Name="Text size"/>
                                    <TextBlock Text="{Binding Appearance.TextScaleText}" Classes="muted"/>
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,12,0,0" Spacing="5">
                                    <TextBlock Text="Theme" FontWeight="SemiBold"/>
                                    <ComboBox Classes="settings-select" ItemsSource="{Binding Appearance.Themes}" SelectedItem="{Binding Appearance.Theme, Mode=TwoWay}" AutomationProperties.Name="Colour theme"/>
                                </StackPanel>
                                <StackPanel Grid.Row="2" Margin="0,12,0,0" Spacing="5">
                                    <TextBlock Text="Spacing" FontWeight="SemiBold"/>
                                    <ComboBox Classes="settings-select" ItemsSource="{Binding Appearance.SpacingScales}" SelectedItem="{Binding Appearance.SpacingScale, Mode=TwoWay}" AutomationProperties.Name="Control spacing"/>
                                    <TextBlock Text="{Binding Appearance.SpacingScaleText}" Classes="muted"/>
                                </StackPanel>
                                <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,12,0,0" Spacing="5">
                                    <TextBlock Text="Motion" FontWeight="SemiBold"/>
                                    <ComboBox Classes="settings-select" ItemsSource="{Binding Appearance.MotionPreferences}" SelectedItem="{Binding Appearance.ReducedMotion, Mode=TwoWay}" AutomationProperties.Name="Reduced motion"/>
                                </StackPanel>
                                <StackPanel Grid.Row="3" Margin="0,12,0,0" Spacing="5">
                                    <TextBlock Text="Colour-vision palette" FontWeight="SemiBold"/>
                                    <ComboBox Classes="settings-select" ItemsSource="{Binding Appearance.ColorVisionPalettes}" SelectedItem="{Binding Appearance.ColorVisionPalette, Mode=TwoWay}" AutomationProperties.Name="Colour-vision palette"/>
                                </StackPanel>
                                <StackPanel Grid.Row="3" Grid.Column="1" Margin="0,12,0,0" Spacing="8">
                                    <CheckBox Content="Simplified / easy read" IsChecked="{Binding Appearance.EasyRead, Mode=TwoWay}"/>
                                    <CheckBox Content="Enhanced keyboard guidance" IsChecked="{Binding Appearance.EnhancedKeyboard, Mode=TwoWay}"/>
                                </StackPanel>
                            </Grid>
                            <Border Background="{StaticResource CanvasBrush}" BorderBrush="{StaticResource FrameBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="Live preview" FontWeight="Bold" FontFamily="{Binding Appearance.FontFamily}" FontSize="{Binding Appearance.BaseFontSize}"/>
                                    <TextBlock Text="Patient 2 is occupied at First Aid. Status and actions remain written out, not conveyed by colour alone." TextWrapping="Wrap" FontFamily="{Binding Appearance.FontFamily}" FontSize="{Binding Appearance.BaseFontSize}"/>
                                    <Button Classes="primary" Content="Preview action" HorizontalAlignment="Left" MinHeight="{Binding Appearance.ControlHeight}"/>
                                </StackPanel>
                            </Border>
                            <Button Classes="secondary" Content="Reset appearance settings" Command="{Binding Appearance.ResetCommand}" HorizontalAlignment="Left"/>
                            <StackPanel IsVisible="{Binding CanAdminHost}" Spacing="8">
                                <Separator/>
                                <TextBlock Text="Lock-screen blur" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}"/>
                                <TextBlock Text="Adjust how strongly the treatment centre is obscured while locked." Classes="muted" TextWrapping="Wrap"/>
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                    <Slider Minimum="4" Maximum="20" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding LockBlurRadius, Mode=TwoWay}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding LockBlurRadius, StringFormat={}{0:0}px}" Foreground="{StaticResource DeepSeaBrush}" VerticalAlignment="Center"/>
                                </Grid>
                                <TextBlock Text="Updates" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" Margin="0,8,0,0"/>
                                <TextBlock Text="{Binding UpdateStatusText}" Classes="muted" TextWrapping="Wrap"/>
                                <Button Classes="secondary" Content="Check for updates" Command="{Binding CheckForUpdatesCommand}" HorizontalAlignment="Left"/>
                            </StackPanel>
                            <TextBlock Text="{Binding ApplicationVersion, StringFormat=TCM+ {0}}" Foreground="{StaticResource DeepSeaBrush}"/>
                        </StackPanel>
                    </ScrollViewer>
                    <StackPanel IsVisible="{Binding IsSettingsOperations}" Spacing="12">
                        <TextBlock Text="Operations" Classes="section-title"/>
                        <TextBlock Text="Discharge routes" Classes="muted"/>
                        <ListBox ItemsSource="{Binding DischargeRoutes}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="*,Auto" Margin="0,4">
                                        <TextBlock Text="{Binding}" VerticalAlignment="Center"/>
                                        <Button Grid.Column="1" Classes="danger" Content="Remove" Command="{Binding DataContext.RemoveDischargeRouteCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBox Text="{Binding NewDischargeRoute}" Width="260" PlaceholderText="New discharge route"/>
                            <Button Classes="primary" Content="Add route" Command="{Binding AddDischargeRouteCommand}"/>
                        </StackPanel>
                        <TextBlock Text="Keep at least one route." Classes="muted"/>
                    </StackPanel>
                    <ScrollViewer IsVisible="{Binding IsSettingsDisplays}" VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="14">
                            <TextBlock Text="Displays and terminals" Classes="section-title"/>
                            <StackPanel IsVisible="{Binding CanAdminHost}" Spacing="10">
                            <TextBlock Text="Secure app-to-app terminals" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}"/>
                            <TextBlock Text="Enable terminal connections here when they are needed. A terminal must be approved using the six-digit code shown on its own screen."
                                       Classes="muted" TextWrapping="Wrap"/>
                            <Button IsVisible="{Binding IsTerminalHostStopped}" Classes="primary" Content="Enable terminal connections" Command="{Binding StartTerminalHostCommand}"/>
                            <StackPanel IsVisible="{Binding IsTerminalHostRunning}" Spacing="10">
                                <TextBlock Text="{Binding TerminalHostStatus}" Classes="muted" TextWrapping="Wrap"/>
                                <Border Background="#EAF5EF" BorderBrush="#87BBA2" BorderThickness="1" CornerRadius="8" Padding="14">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="Host code" FontWeight="SemiBold" Foreground="#364958"/>
                                        <TextBlock Text="{Binding TerminalHostCode}" FontFamily="Consolas" FontSize="28" FontWeight="Bold" Foreground="#3B6064"/>
                                        <TextBlock Text="Use this only if the terminal cannot find the host automatically. It identifies this host; it is not a password." Classes="muted" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                                <TextBlock Text="Approved terminal sessions" FontWeight="SemiBold"/>
                                <ItemsControl ItemsSource="{Binding RegisteredTerminals}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid ColumnDefinitions="*,Auto" Margin="0,4">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding ExpiresAt, StringFormat=Expires {0:g}}" Classes="muted"/>
                                                </StackPanel>
                                                <Button Grid.Column="1" Classes="danger" Content="Revoke"
                                                        Command="{Binding DataContext.RevokeTerminalCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}" IsEnabled="{Binding IsActive}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Button Classes="secondary" Content="Disable terminal connections" Command="{Binding StopTerminalHostCommand}" HorizontalAlignment="Left"/>
                                <Button Classes="secondary" Content="Refresh command audit" Command="{Binding RefreshTerminalAuditCommand}"/>
                                <ItemsControl ItemsSource="{Binding TerminalAuditEntries}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid ColumnDefinitions="70,140,*,Auto" ColumnSpacing="8" Margin="0,2">
                                                <TextBlock Text="{Binding Sequence, StringFormat=#{0}}"/>
                                                <TextBlock Grid.Column="1" Text="{Binding TerminalName}"/>
                                                <TextBlock Grid.Column="2" Text="{Binding Operation}"/>
                                                <TextBlock Grid.Column="3" Text="{Binding Status}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Button Classes="danger" Content="Stop terminal host and revoke all access" Command="{Binding StopTerminalHostCommand}"/>
                            </StackPanel></StackPanel>
                            <Separator/>
                            <TextBlock Text="Connected display" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}"/>
                            <TextBlock Text="Open a local read-only Dashboard or Map display. With one monitor this opens as a movable preview; with multiple monitors it opens on the preferred display." Classes="muted" TextWrapping="Wrap"/>
                            <Button Classes="primary" Content="Open Dashboard display" Command="{Binding OpenExternalDisplayCommand}" CommandParameter="Dashboard"/>
                            <Button Classes="secondary" Content="Open Map mirror" Command="{Binding OpenExternalDisplayCommand}" CommandParameter="Map"/>
                            <Separator IsVisible="{Binding CanAdminHost}"/>
                            <StackPanel IsVisible="{Binding CanAdminHost}" Spacing="10">
                            <TextBlock Text="LAN web display" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}"/>
                            <TextBlock Text="Start a read-only Dashboard and Map mirror for browsers on this local network. Windows Firewall may ask you to allow access." Classes="muted" TextWrapping="Wrap"/>
                            <Button IsVisible="{Binding IsLanDisplayStopped}" Classes="primary" Content="Start LAN web display" Command="{Binding StartLanDisplayCommand}"/>
                            <StackPanel IsVisible="{Binding IsLanDisplayRunning}" Spacing="10">
                                <TextBlock Text="{Binding LanDisplayStatus}" Classes="muted" TextWrapping="Wrap"/>
                                <TextBlock Text="Viewer PIN" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}"/>
                                <TextBlock Text="{Binding LanDisplayPin}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource DeepSeaBrush}"/>
                                <ItemsControl ItemsSource="{Binding LanDisplayAddresses}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Spacing="4" Margin="0,4">
                                                <TextBlock Text="{Binding Host}" FontWeight="SemiBold"/>
                                                <TextBlock Text="Dashboard" Classes="muted"/>
                                                <TextBox Text="{Binding DashboardUrl}" IsReadOnly="True"/>
                                                <TextBlock Text="Map" Classes="muted"/>
                                                <TextBox Text="{Binding MapUrl}" IsReadOnly="True"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Button Classes="danger" Content="Stop LAN web display" Command="{Binding StopLanDisplayCommand}"/>
                            </StackPanel></StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <ScrollViewer Grid.Row="2" Margin="28" IsVisible="{Binding IsDashboard}" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="16">
                <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="16">
                    <Border Classes="card" Padding="18"><StackPanel Spacing="5"><TextBlock Text="{Binding AvailableStations}" FontSize="30" FontWeight="Bold" Foreground="{StaticResource OpenBrush}" /><TextBlock Text="Available stations" Classes="muted" /></StackPanel></Border>
                    <Border Grid.Column="1" Classes="card" Padding="18"><StackPanel Spacing="5"><TextBlock Text="{Binding OccupiedStations}" FontSize="30" FontWeight="Bold" Foreground="{StaticResource ClosedBrush}" /><TextBlock Text="Occupied stations" Classes="muted" /></StackPanel></Border>
                    <Border Grid.Column="2" Classes="card" Padding="18"><StackPanel Spacing="5"><TextBlock Text="{Binding PatientsSeenThisShift}" FontSize="30" FontWeight="Bold" Foreground="{StaticResource DeepSeaBrush}" /><TextBlock Text="Patients seen this shift" Classes="muted" TextWrapping="Wrap" /></StackPanel></Border>
                    <Border Grid.Column="3" Classes="card" Padding="18"><StackPanel Spacing="5"><TextBlock Text="{Binding AverageDischargeText}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource SeaBrush}" /><TextBlock Text="Average discharge time" Classes="muted" TextWrapping="Wrap" /></StackPanel></Border>
                </Grid>
                <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                    <Border Classes="card" Padding="20"><Grid><StackPanel IsVisible="{Binding HasComplaintBreakdown}" Spacing="8"><TextBlock Text="Presenting complaints" Classes="section-title" /><Grid ColumnDefinitions="1.15*,*" ColumnSpacing="14"><charts:DashboardPieChart Slices="{Binding ComplaintBreakdown}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" /><ItemsControl Grid.Column="1" ItemsSource="{Binding ComplaintBreakdown}"><ItemsControl.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal" Spacing="6" Margin="0,4"><Ellipse Width="9" Height="9" Fill="{Binding Color}" VerticalAlignment="Center" /><TextBlock Text="{Binding Label}" Foreground="{StaticResource InkBrush}" TextWrapping="Wrap" /><TextBlock Text="{Binding Value}" Classes="muted" /></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></Grid></StackPanel><StackPanel IsVisible="{Binding HasNoComplaintBreakdown}" VerticalAlignment="Center" HorizontalAlignment="Center"><TextBlock Text="Presenting complaints" Classes="section-title" HorizontalAlignment="Center" /><TextBlock Text="No recorded complaints yet." Classes="muted" Margin="0,8,0,0" /></StackPanel></Grid></Border>
                    <Border Grid.Column="1" Classes="card" Padding="20"><Grid><StackPanel IsVisible="{Binding HasDischargeRouteBreakdown}" Spacing="8"><TextBlock Text="Discharge routes" Classes="section-title" /><Grid ColumnDefinitions="1.15*,*" ColumnSpacing="14"><charts:DashboardPieChart Slices="{Binding DischargeRouteBreakdown}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" /><ItemsControl Grid.Column="1" ItemsSource="{Binding DischargeRouteBreakdown}"><ItemsControl.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal" Spacing="6" Margin="0,4"><Ellipse Width="9" Height="9" Fill="{Binding Color}" VerticalAlignment="Center" /><TextBlock Text="{Binding Label}" Foreground="{StaticResource InkBrush}" TextWrapping="Wrap" /><TextBlock Text="{Binding Value}" Classes="muted" /></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></Grid></StackPanel><StackPanel IsVisible="{Binding HasNoDischargeRouteBreakdown}" VerticalAlignment="Center" HorizontalAlignment="Center"><TextBlock Text="Discharge routes" Classes="section-title" HorizontalAlignment="Center" /><TextBlock Text="No discharges recorded yet." Classes="muted" Margin="0,8,0,0" /></StackPanel></Grid></Border>
                </Grid>
                <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                    <Border Classes="card" Padding="20"><Grid><StackPanel IsVisible="{Binding HasThroughput}"><TextBlock Text="Discharges per hour" Classes="section-title" /><TextBlock Text="{Binding AverageThroughputText}" Classes="muted" Margin="0,3,0,8" /><charts:DashboardTrendChart Points="{Binding ThroughputPoints}" Height="220" LineBrush="#3B6064" /></StackPanel><StackPanel IsVisible="{Binding HasNoThroughput}" VerticalAlignment="Center" HorizontalAlignment="Center"><TextBlock Text="Discharges per hour" Classes="section-title" /><TextBlock Text="No discharges yet." Classes="muted" Margin="0,8,0,0" /></StackPanel></Grid></Border>
                    <Border Grid.Column="1" Classes="card" Padding="20"><Grid><StackPanel IsVisible="{Binding HasDischargeDurations}"><TextBlock Text="Discharge duration" Classes="section-title" /><TextBlock Text="Minutes from arrival to discharge" Classes="muted" Margin="0,3,0,8" /><charts:DashboardTrendChart Points="{Binding DischargeDurationPoints}" Height="220" LineBrush="#B94B4B" /></StackPanel><StackPanel IsVisible="{Binding HasNoDischargeDurations}" VerticalAlignment="Center" HorizontalAlignment="Center"><TextBlock Text="Discharge duration" Classes="section-title" /><TextBlock Text="No completed visits yet." Classes="muted" Margin="0,8,0,0" /></StackPanel></Grid></Border>
                </Grid>
            </StackPanel>
        </ScrollViewer>
            </Grid>
        </Border>

        <Border IsVisible="{Binding IsTerminalReconnecting}"
                ZIndex="95"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="20,72,20,0"
                Padding="16,10"
                Background="#FFF5D9"
                BorderBrush="#D39B28"
                BorderThickness="1"
                CornerRadius="8"
                BoxShadow="0 6 20 0 #00000033">
            <Grid ColumnDefinitions="Auto,Auto,Auto" ColumnSpacing="12">
                <StackPanel>
                    <TextBlock Text="Host connection interrupted" FontWeight="Bold" Foreground="#765617"/>
                    <TextBlock Text="{Binding TerminalConnectionStatus}" Foreground="#765617" TextWrapping="Wrap" MaxWidth="620"/>
                    <TextBlock Text="The displayed data is stale. Eligible commands remain encrypted locally with their original request IDs."
                               Foreground="#765617" FontSize="12" TextWrapping="Wrap" MaxWidth="620"/>
                </StackPanel>
                <Button Grid.Column="1" Classes="secondary" Content="Retry now" Command="{Binding RetryTerminalConnectionCommand}" VerticalAlignment="Center"/>
                <Button Grid.Column="2" Classes="danger" Content="Leave terminal" Command="{Binding LeaveTerminalCommand}" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <Border Classes="banner" IsVisible="{Binding IsBannerVisible}" ZIndex="90" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,136,20,0" Padding="16,8">
            <StackPanel Orientation="Horizontal" Spacing="10"><TextBlock Text="{Binding BannerText}" Foreground="#364958" FontWeight="SemiBold" VerticalAlignment="Center" /><Ellipse Classes="notification-info" Classes.notification-info="{Binding IsNotificationInfo}" Classes.notification-warning="{Binding IsNotificationWarning}" Classes.notification-error="{Binding IsNotificationError}" Width="10" Height="10" VerticalAlignment="Center" /></StackPanel>
        </Border>

        <Border IsVisible="{Binding IsTerminalEnded}" ZIndex="110" Background="#364958D9">
            <Border Width="560"
                    MaxWidth="720"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="White"
                    BorderBrush="#87BBA2"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="30"
                    BoxShadow="0 16 48 0 #00000055">
                <StackPanel Spacing="14">
                    <TextBlock Text="Terminal session ended" FontSize="22" FontWeight="Bold" Foreground="{StaticResource InkBrush}" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding TerminalEndedMessage}" Classes="muted" TextWrapping="Wrap" TextAlignment="Center"/>
                    <Border IsVisible="{Binding HasUnresolvedTerminalCommands}"
                            Background="#FFF5D9"
                            BorderBrush="#D39B28"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="14">
                        <StackPanel Spacing="8">
                            <TextBlock Text="{Binding UnresolvedTerminalCommands, StringFormat={}{0} command(s) could not be confirmed.}"
                                       FontWeight="SemiBold"
                                       Foreground="#765617"
                                       TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding TerminalQueueReviewText}"
                                       Foreground="#765617"
                                       FontFamily="Consolas"
                                       FontSize="12"
                                       TextWrapping="Wrap"/>
                            <TextBlock Text="These operation-only records will never be replayed. Acknowledge them before returning to pairing."
                                       Foreground="#765617"
                                       FontSize="12"
                                       TextWrapping="Wrap"/>
                            <Button Classes="secondary"
                                    Content="Acknowledge unresolved commands"
                                    Command="{Binding AcknowledgeUnresolvedTerminalCommandsCommand}"
                                    HorizontalAlignment="Left"/>
                        </StackPanel>
                    </Border>
                    <Button Classes="primary"
                            Content="Return to terminal pairing"
                            Command="{Binding ReturnToPairingCommand}"
                            IsEnabled="{Binding CanReturnToPairing}"
                            HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Border>

        <Border IsVisible="{Binding IsLocked}" ZIndex="100" Background="#364958B8">
            <Border Width="520" HorizontalAlignment="Center" VerticalAlignment="Center" Background="White" BorderBrush="#87BBA2" BorderThickness="1" CornerRadius="14" Padding="30" BoxShadow="0 16 48 0 #00000055">
                <StackPanel Spacing="15">
                    <TextBlock Text="Secure PIN verification" FontSize="21" FontWeight="Bold" Foreground="#364958" HorizontalAlignment="Center" />
                    <TextBlock Text="Enter this shift's six-digit security code." Classes="muted" HorizontalAlignment="Center" />
                    <TextBox Name="UnlockPinInput" Text="{Binding UnlockPinEntry, Mode=TwoWay}" MaxLength="6" PasswordChar="*" Width="280" HorizontalAlignment="Center" FontSize="20" HorizontalContentAlignment="Center" PlaceholderText="Six-digit PIN" AutomationProperties.Name="Six-digit shift PIN" KeyDown="OnUnlockPinKeyDown" />
                    <CheckBox Content="Show PIN" HorizontalAlignment="Center" Click="OnToggleUnlockPinVisibility"/>
                    <TextBlock Text="{Binding LockMessage}" Foreground="#963D3D" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" />
                    <Button Classes="primary" Content="Unlock" Command="{Binding UnlockCommand}" HorizontalAlignment="Center" />
                    <Button Classes="secondary" Content="Load or switch shift" Command="{Binding RequestSessionSwitchCommand}" HorizontalAlignment="Center" />
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</Window>
