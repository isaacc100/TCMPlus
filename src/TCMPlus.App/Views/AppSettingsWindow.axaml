<views:ResponsiveDialogWindow xmlns="https://github.com/avaloniaui"
                              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                              xmlns:views="using:TCMPlus.App.Views"
                              x:Class="TCMPlus.App.Views.AppSettingsWindow"
                              Width="500"
                              Height="440"
                              CanResize="False"
                              WindowStartupLocation="CenterOwner"
                              Title="Application settings"
                              Background="#F5F8F4">
  <Border Classes="dialog-card">
    <Grid RowDefinitions="Auto,*,Auto">
      <TextBlock Classes="dialog-header" Text="Application settings"/>
      <ScrollViewer Grid.Row="1" Classes="dialog-body" Margin="0,12,0,0">
        <StackPanel Spacing="12">
          <TextBlock Text="Discharge routes" FontWeight="SemiBold" Foreground="#364958"/>
          <ListBox Name="RoutesList" Height="190"/>
          <WrapPanel ItemSpacing="8" LineSpacing="8">
            <TextBox Name="NewRouteInput" Width="250" PlaceholderText="New discharge route"/>
            <Button Content="Add" Click="OnAddRoute"/>
            <Button Content="Remove selected" Click="OnRemoveRoute"/>
          </WrapPanel>
          <WrapPanel ItemSpacing="10" LineSpacing="8">
            <TextBlock Text="External display" VerticalAlignment="Center" Foreground="#364958"/>
            <ComboBox Name="DisplayModeInput" Width="150" SelectedIndex="0">
              <ComboBoxItem Content="Dashboard"/>
              <ComboBoxItem Content="Map mirror"/>
            </ComboBox>
          </WrapPanel>
        </StackPanel>
      </ScrollViewer>
      <WrapPanel Grid.Row="2" Classes="dialog-footer">
        <Button Content="Open external display" Click="OnOpenDisplay"/>
        <Button Content="Cancel" Click="OnCancel"/>
        <Button Classes="primary" Content="Save settings" Click="OnSave"/>
      </WrapPanel>
    </Grid>
  </Border>
</views:ResponsiveDialogWindow>
