<views:ResponsiveDialogWindow xmlns="https://github.com/avaloniaui"
                              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                              xmlns:views="using:TCMPlus.App.Views"
                              x:Class="TCMPlus.App.Views.AddStationDialog"
                              Width="420"
                              Height="330"
                              CanResize="False"
                              WindowStartupLocation="CenterOwner"
                              Title="Add station"
                              Background="#F5F8F4">
  <Border Classes="dialog-card">
    <Grid RowDefinitions="Auto,*,Auto">
      <TextBlock Classes="dialog-header" Text="Add station"/>
      <ScrollViewer Grid.Row="1" Classes="dialog-body" Margin="0,12,0,0">
        <StackPanel Spacing="11">
          <TextBlock Text="Name" FontWeight="SemiBold" Foreground="#364958"/>
          <TextBox Name="StationNameInput" PlaceholderText="e.g. Bay 1" KeyDown="OnNameKeyDown"/>
          <TextBlock Text="Type" FontWeight="SemiBold" Foreground="#364958"/>
          <TextBox Name="StationTypeInput" PlaceholderText="e.g. Resus, Bed, Minors" KeyDown="OnSubmitKeyDown"/>
          <TextBlock Name="ValidationMessage" Foreground="#963D3D" FontSize="11" TextWrapping="Wrap"/>
        </StackPanel>
      </ScrollViewer>
      <StackPanel Grid.Row="2" Classes="dialog-footer">
        <Button Classes="secondary" Content="Cancel" Click="OnCancel"/>
        <Button Classes="primary" Content="Add station" Click="OnAddStation"/>
      </StackPanel>
    </Grid>
  </Border>
</views:ResponsiveDialogWindow>
