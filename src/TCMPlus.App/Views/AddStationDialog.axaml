<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="TCMPlus.App.Views.AddStationDialog"
        Width="420"
        Height="330"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Title="Add station"
        Background="#F5F8F4">
    <Window.Styles>
        <Style Selector="Button.primary">
            <Setter Property="Background" Value="#3B6064" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="14,9" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>
        <Style Selector="Button.secondary">
            <Setter Property="Background" Value="#E7F5EC" />
            <Setter Property="Foreground" Value="#245A42" />
            <Setter Property="BorderBrush" Value="#87BBA2" />
            <Setter Property="Padding" Value="13,8" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>
    </Window.Styles>
    <Border Margin="18" Background="White" BorderBrush="#D5E2DA" BorderThickness="1" CornerRadius="10" Padding="20">
        <StackPanel Spacing="11">
            <TextBlock Text="Add station" FontSize="18" FontWeight="Bold" Foreground="#364958" />
            <TextBlock Text="Name" FontWeight="SemiBold" Foreground="#364958" />
            <TextBox Name="StationNameInput" PlaceholderText="e.g. Bay 1" />
            <TextBlock Text="Type" FontWeight="SemiBold" Foreground="#364958" />
            <TextBox Name="StationTypeInput" PlaceholderText="e.g. Resus, Bed, Minors" />
            <TextBlock Name="ValidationMessage" Foreground="#963D3D" FontSize="11" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,4,0,0">
                <Button Classes="secondary" Content="Cancel" Click="OnCancel" />
                <Button Classes="primary" Content="Add station" Click="OnAddStation" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
