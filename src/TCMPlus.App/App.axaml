<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="TCMPlus.App.App"
             RequestedThemeVariant="Light">
    <Application.Resources>
        <SolidColorBrush x:Key="MistBrush" Color="#C9E4CA" />
        <SolidColorBrush x:Key="SageBrush" Color="#87BBA2" />
        <SolidColorBrush x:Key="SeaBrush" Color="#55828B" />
        <SolidColorBrush x:Key="DeepSeaBrush" Color="#3B6064" />
        <SolidColorBrush x:Key="InkBrush" Color="#364958" />
        <SolidColorBrush x:Key="CanvasBrush" Color="#F5F8F4" />
        <SolidColorBrush x:Key="OpenBrush" Color="#2F8F61" />
        <SolidColorBrush x:Key="OpenSoftBrush" Color="#E7F5EC" />
        <SolidColorBrush x:Key="ClosedBrush" Color="#B94B4B" />
        <SolidColorBrush x:Key="ClosedSoftBrush" Color="#FCEAEA" />
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <Style Selector="Button.primary">
            <Setter Property="Background" Value="#3B6064"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,9"/>
            <Setter Property="CornerRadius" Value="6"/>
        </Style>
        <Style Selector="Button.secondary">
            <Setter Property="Background" Value="#E7F5EC"/>
            <Setter Property="Foreground" Value="#245A42"/>
            <Setter Property="BorderBrush" Value="#87BBA2"/>
            <Setter Property="Padding" Value="13,8"/>
            <Setter Property="CornerRadius" Value="6"/>
        </Style>
        <Style Selector="Button.danger">
            <Setter Property="Background" Value="#FCEAEA"/>
            <Setter Property="Foreground" Value="#963D3D"/>
            <Setter Property="BorderBrush" Value="#E5A0A0"/>
            <Setter Property="Padding" Value="13,8"/>
            <Setter Property="CornerRadius" Value="6"/>
        </Style>
    </Application.Styles>
</Application>
